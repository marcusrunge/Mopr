<UserControl x:Class="MarcusRunge.Mopr.Workbench.Modules.Import.Views.ImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:properties="clr-namespace:MarcusRunge.Mopr.Workbench.Modules.Import.Properties"
             xmlns:viewmodels="clr-namespace:MarcusRunge.Mopr.Workbench.Modules.Import.ViewModels"
             Width="760"
             MinWidth="680"
             d:DataContext="{d:DesignInstance Type=viewmodels:ImportViewModel}"
             d:DesignHeight="600"
             d:DesignWidth="760"
             mc:Ignorable="d"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="Width"
                Value="760" />
            <Setter Property="MinWidth"
                Value="680" />
            <Setter Property="MaxHeight"
                Value="720" />
            <Setter Property="SizeToContent"
                Value="Height" />
            <Setter Property="prism:Dialog.WindowStartupLocation"
                Value="CenterOwner" />
            <Setter Property="ResizeMode"
                Value="CanResize" />
            <Setter Property="ShowInTaskbar"
                Value="False" />
            <Setter Property="Background"
                Value="#10161C" />
        </Style>
    </prism:Dialog.WindowStyle>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">
            <Setter Property="MinWidth"
                    Value="130" />
            <Setter Property="Height"
                    Value="38" />
            <Setter Property="Padding"
                    Value="16,7" />
            <Setter Property="Background"
                    Value="#2E78B7" />
            <Setter Property="Foreground"
                    Value="White" />
            <Setter Property="BorderBrush"
                    Value="#4C96D2" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
        </Style>

        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button">
            <Setter Property="MinWidth"
                    Value="120" />
            <Setter Property="Height"
                    Value="38" />
            <Setter Property="Padding"
                    Value="16,7" />
            <Setter Property="Background"
                    Value="#26333E" />
            <Setter Property="Foreground"
                    Value="#ECF3F8" />
            <Setter Property="BorderBrush"
                    Value="#506372" />
            <Setter Property="BorderThickness"
                    Value="1" />
        </Style>

        <Style x:Key="PrimaryMetricValueStyle"
               TargetType="TextBlock">
            <Setter Property="HorizontalAlignment"
                    Value="Center" />
            <Setter Property="Foreground"
                    Value="#F2F7FA" />
            <Setter Property="FontSize"
                    Value="24" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
        </Style>

        <Style x:Key="MetricLabelStyle"
               TargetType="TextBlock">
            <Setter Property="Margin"
                    Value="0,4,0,0" />
            <Setter Property="HorizontalAlignment"
                    Value="Center" />
            <Setter Property="Foreground"
                    Value="#9FB1BE" />
            <Setter Property="FontSize"
                    Value="12" />
        </Style>
    </UserControl.Resources>

    <Grid Background="#10161C">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="24,20"
                Background="#182129"
                BorderBrush="#2F3E49"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Foreground="#F3F7FA"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Text="{x:Static properties:Resources.ImportTitle}" />

                <TextBlock Margin="0,6,0,0"
                           Foreground="#AFC0CB"
                           FontSize="13"
                           Text="{x:Static properties:Resources.ImportSubtitle}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      Padding="24,20"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Padding="18"
                        Background="#182129"
                        BorderBrush="#334550"
                        BorderThickness="1"
                        CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Margin="0,0,18,0">
                            <TextBlock Foreground="#F1F6F9"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Text="{x:Static properties:Resources.SourceSectionTitle}" />

                            <TextBlock Margin="0,6,0,0"
                                       Foreground="#C6D2DA"
                                       Text="{Binding Source.DisplayName}" />

                            <TextBlock Margin="0,3,0,0"
                                       Foreground="#718796"
                                       FontSize="11"
                                       Text="{Binding Source.Path}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Source.Path}" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                VerticalAlignment="Center"
                                Command="{Binding SelectSourceCommand}"
                                Content="{x:Static properties:Resources.SelectSourceButton}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </Grid>
                </Border>

                <Border Margin="0,14,0,0"
                        Padding="18"
                        Background="#182129"
                        BorderBrush="#334550"
                        BorderThickness="1"
                        CornerRadius="6"
                        Visibility="{Binding IsImporting, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Foreground="#F1F6F9"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Text="{x:Static properties:Resources.ImportRunningTitle}" />

                        <TextBlock Margin="0,6,0,13"
                                   Foreground="#AFC0CB"
                                   FontSize="13"
                                   Text="{x:Static properties:Resources.ImportRunningMessage}"
                                   TextWrapping="Wrap" />

                        <ProgressBar Height="7"
                                     IsIndeterminate="True" />
                    </StackPanel>
                </Border>

                <Border Margin="0,14,0,0"
                        Padding="18"
                        Background="#182129"
                        BorderBrush="#334550"
                        BorderThickness="1"
                        CornerRadius="6"
                        Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Foreground="#F1F6F9"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Text="{x:Static properties:Resources.ResultSectionTitle}" />

                        <TextBlock Margin="0,6,0,18"
                                   Foreground="#C7D4DC"
                                   FontSize="13"
                                   Text="{Binding Result.Message}"
                                   TextWrapping="Wrap" />

                        <UniformGrid Columns="3">
                            <StackPanel>
                                <TextBlock Style="{StaticResource PrimaryMetricValueStyle}"
                                           Text="{Binding Result.ImportedFiles}" />
                                <TextBlock Style="{StaticResource MetricLabelStyle}"
                                           Text="{x:Static properties:Resources.ImportedFilesLabel}" />
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Style="{StaticResource PrimaryMetricValueStyle}"
                                           Text="{Binding Result.SkippedFiles}" />
                                <TextBlock Style="{StaticResource MetricLabelStyle}"
                                           Text="{x:Static properties:Resources.SkippedFilesLabel}" />
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Style="{StaticResource PrimaryMetricValueStyle}"
                                           Text="{Binding Result.FailedFiles}" />
                                <TextBlock Style="{StaticResource MetricLabelStyle}"
                                           Text="{x:Static properties:Resources.FailedFilesLabel}" />
                            </StackPanel>
                        </UniformGrid>

                        <Border Height="1"
                                Margin="0,18,0,14"
                                Background="#2F3E49" />

                        <UniformGrid Columns="3">
                            <StackPanel>
                                <TextBlock HorizontalAlignment="Center"
                                           Foreground="#C8D4DB"
                                           Text="{Binding Result.DiscoveredFiles}" />
                                <TextBlock Style="{StaticResource MetricLabelStyle}"
                                           Text="{x:Static properties:Resources.DiscoveredFilesLabel}" />
                            </StackPanel>

                            <StackPanel>
                                <TextBlock HorizontalAlignment="Center"
                                           Foreground="#C8D4DB"
                                           Text="{Binding Result.ValidDicomFiles}" />
                                <TextBlock Style="{StaticResource MetricLabelStyle}"
                                           Text="{x:Static properties:Resources.ValidDicomFilesLabel}" />
                            </StackPanel>

                            <StackPanel>
                                <TextBlock HorizontalAlignment="Center"
                                           Foreground="#C8D4DB"
                                           Text="{Binding Result.ImportableFiles}" />
                                <TextBlock Style="{StaticResource MetricLabelStyle}"
                                           Text="{x:Static properties:Resources.ImportableFilesLabel}" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                MinHeight="68"
                Padding="20,12"
                Background="#182129"
                BorderBrush="#2F3E49"
                BorderThickness="0,1,0,0">
            <Grid VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Left"
                            Orientation="Horizontal">
                    <Button Command="{Binding StartNewImportCommand}"
                            Content="{x:Static properties:Resources.NewImportButton}"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>

                <StackPanel HorizontalAlignment="Right"
                            Orientation="Horizontal">
                    <Button Margin="0,0,10,0"
                            Command="{Binding CancelImportCommand}"
                            Content="{x:Static properties:Resources.CancelImportButton}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Visibility="{Binding IsImporting, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <Button Margin="0,0,10,0"
                            Command="{Binding CloseDialogCommand}"
                            Content="{x:Static properties:Resources.CloseDialogButton}"
                            Style="{StaticResource SecondaryButtonStyle}" />

                    <Button Command="{Binding StartImportCommand}"
                            Content="{x:Static properties:Resources.StartImportButton}"
                            IsDefault="True"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
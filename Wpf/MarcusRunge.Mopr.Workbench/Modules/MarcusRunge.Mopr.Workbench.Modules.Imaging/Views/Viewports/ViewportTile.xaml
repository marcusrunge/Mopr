<UserControl x:Class="MarcusRunge.Mopr.Workbench.Modules.Imaging.Views.Viewports.ViewportTile"
             
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:MarcusRunge.Mopr.Workbench.Modules.Imaging.ViewModels" 
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:ViewportTileViewModel}">

    <UserControl.Resources>
        <Style x:Key="ViewportBorderStyle"
               TargetType="Border">
            <Setter Property="Background" Value="#05080A"/>
            <Setter Property="BorderBrush" Value="#1F2933"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>

            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             Value="True">
                    <Setter Property="BorderBrush" Value="#60E1EB"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource ViewportBorderStyle}"
            PreviewMouseLeftButtonDown="OnViewportPreviewMouseLeftButtonDown"
            PreviewMouseMove="OnViewportPreviewMouseMove"
            PreviewMouseLeftButtonUp="OnViewportPreviewMouseLeftButtonUp"
            Tag="{Binding ViewportId, RelativeSource={RelativeSource AncestorType=UserControl}}">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Viewport leeren"
                          Command="{Binding ClearViewportCommand}"
                          CommandParameter="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            </ContextMenu>
        </Border.ContextMenu>
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#0D1318"
                    BorderBrush="#1F2933"
                    BorderThickness="0,0,0,1"
                    Padding="10,0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding Tile.DisplayTitle, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Foreground="#DDE5EC"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Tile.DisplayTitle, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

                    <TextBlock Grid.Column="1"
                               Text="{Binding Tile.SliceDisplayText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Foreground="#6F7B86"
                               FontSize="11"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  Background="#020405">
                <Image Source="{Binding Tile.CurrentImage, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding Tile.IsEmptyViewerVisible, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">

                    <TextBlock Text="Kein Bild"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#7D8790"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="{Binding Tile.DisplaySubtitle, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               FontSize="12"
                               Foreground="#58636E"
                               Margin="0,6,0,0"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
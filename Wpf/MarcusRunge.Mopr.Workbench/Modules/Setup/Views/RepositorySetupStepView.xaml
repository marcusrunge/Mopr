<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:properties="clr-namespace:MarcusRunge.Mopr.Workbench.Modules.Setup.Properties" x:Class="MarcusRunge.Mopr.Workbench.Modules.Setup.Views.Steps.RepositorySetupStepView" d:DesignHeight="560" d:DesignWidth="788" mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MarcusRunge.Mopr.Workbench.Modules.Setup;component/Themes/SetupControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Padding="32" VerticalAlignment="Top" Background="{StaticResource SetupCardBackgroundBrush}" BorderBrush="{StaticResource SetupCardBorderBrush}" BorderThickness="1" CornerRadius="9">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="28"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="22"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="48" Height="48" Background="{StaticResource SetupAccentBackgroundBrush}" BorderBrush="#2A5963" BorderThickness="1" CornerRadius="7">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource SetupAccentBrush}" FontSize="16" FontWeight="Bold" Text="FS"/>
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource SetupSectionTitleStyle}" Text="{x:Static properties:Resources.Setup_RepositoryTitle}"/>
                    <TextBlock Margin="0,5,0,0" Style="{StaticResource SetupDescriptionStyle}" Text="{x:Static properties:Resources.Setup_RepositoryDescription}"/>
                </StackPanel>
            </Grid>
            <Border Grid.Row="2" Background="{StaticResource SetupCardBorderBrush}"/>
            <StackPanel Grid.Row="4">
                <TextBlock Margin="0,0,0,8" Style="{StaticResource SetupLabelStyle}" Text="{x:Static properties:Resources.Setup_RepositoryPathLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Style="{StaticResource SetupTextBoxStyle}" IsEnabled="{Binding CanModify}" Text="{Binding RepositoryLocationPath, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Column="2" Style="{StaticResource SetupSecondaryButtonStyle}" Command="{Binding SelectRepositoryLocationCommand}" Content="{x:Static properties:Resources.Setup_SelectRepositoryLocation}"/>
                </Grid>
            </StackPanel>
            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource SetupPrimaryButtonStyle}" Command="{Binding ValidateRepositoryLocationCommand}" Content="{x:Static properties:Resources.Setup_ValidateRepositoryLocation}"/>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <ProgressBar Height="4" IsIndeterminate="True">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsValidatingRepositoryLocation}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                    <TextBlock FontSize="13" Text="{Binding RepositoryStatusText}" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource SetupSecondaryTextBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRepositoryLocationValid}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource SetupSuccessBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsRepositoryLocationValid}" Value="False">
                                        <Setter Property="Foreground" Value="{StaticResource SetupErrorBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
            <Border Grid.Row="8" Padding="15" Background="#14232B" BorderBrush="{StaticResource SetupCardBorderBrush}" BorderThickness="1" CornerRadius="6">
                <TextBlock Foreground="{StaticResource SetupSecondaryTextBrush}" FontSize="13" Text="{x:Static properties:Resources.Setup_RepositoryTemporaryNotice}" TextWrapping="Wrap"/>
            </Border>
            <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SetupSecondaryButtonStyle}" Command="{Binding BackCommand}" Content="{x:Static properties:Resources.Setup_Back}" Margin="0,0,12,0"/>
                <Button Style="{StaticResource SetupPrimaryButtonStyle}" Command="{Binding ContinueCommand}" Content="{x:Static properties:Resources.Setup_Continue}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
<UserControl x:Class="MarcusRunge.Mopr.Workbench.Modules.Setup.Views.Steps.CompletionSetupStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:properties="clr-namespace:MarcusRunge.Mopr.Workbench.Modules.Setup.Properties"
             d:DesignHeight="520"
             d:DesignWidth="788"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MarcusRunge.Mopr.Workbench.Modules.Setup;component/Themes/SetupControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Padding="32"
            VerticalAlignment="Top"
            Background="{StaticResource SetupCardBackgroundBrush}"
            BorderBrush="{StaticResource SetupCardBorderBrush}"
            BorderThickness="1"
            CornerRadius="9">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="1" />
                <RowDefinition Height="24" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Width="48"
                        Height="48"
                        Background="{StaticResource SetupAccentBackgroundBrush}"
                        BorderBrush="#2A5963"
                        BorderThickness="1"
                        CornerRadius="7">

                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource SetupAccentBrush}"
                               FontSize="15"
                               FontWeight="Bold"
                               Text="ARM" />
                </Border>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource SetupSectionTitleStyle}"
                               Text="{x:Static properties:Resources.Setup_CompletionTitle}" />

                    <TextBlock Margin="0,5,0,0"
                               Style="{StaticResource SetupDescriptionStyle}"
                               Text="{x:Static properties:Resources.Setup_CompletionDescription}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="2"
                    Background="{StaticResource SetupCardBorderBrush}" />

            <Border Grid.Row="4"
                    Padding="18"
                    Background="#14232B"
                    BorderBrush="{StaticResource SetupCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Width="24"
                            Height="24"
                            Background="#173740"
                            BorderBrush="#2A5963"
                            BorderThickness="1"
                            CornerRadius="12">

                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource SetupSuccessBrush}"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Text="✓" />
                    </Border>

                    <StackPanel Grid.Column="2">
                        <TextBlock Foreground="{StaticResource SetupTextBrush}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Text="{x:Static properties:Resources.Setup_CompletionReadyTitle}" />

                        <TextBlock Margin="0,7,0,0"
                                   Foreground="{StaticResource SetupSecondaryTextBrush}"
                                   FontSize="13"
                                   LineHeight="20"
                                   Text="{x:Static properties:Resources.Setup_CompletionReadyDescription}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="6"
                    Padding="16"
                    Background="#27231A"
                    BorderBrush="#5B4C26"
                    BorderThickness="1"
                    CornerRadius="6">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Width="24"
                            Height="24"
                            Background="#443819"
                            CornerRadius="12">

                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource SetupWarningBrush}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Text="!" />
                    </Border>

                    <TextBlock Grid.Column="2"
                               VerticalAlignment="Center"
                               Foreground="#D9C98E"
                               FontSize="13"
                               LineHeight="20"
                               Text="{x:Static properties:Resources.Setup_CompletionNoChangesNotice}"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="8"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">

                <Button Style="{StaticResource SetupSecondaryButtonStyle}"
                        Command="{Binding BackCommand}"
                        Content="{x:Static properties:Resources.Setup_Back}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
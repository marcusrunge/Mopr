<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:properties="clr-namespace:MarcusRunge.Mopr.Workbench.Modules.Setup.Properties" x:Class="MarcusRunge.Mopr.Workbench.Modules.Setup.Views.Steps.DatabaseSetupStepView" d:DesignHeight="520" d:DesignWidth="788" mc:Ignorable="d"><UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/MarcusRunge.Mopr.Workbench.Modules.Setup;component/Themes/SetupControls.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources><Border Padding="32" VerticalAlignment="Top" Background="{StaticResource SetupCardBackgroundBrush}" BorderBrush="{StaticResource SetupCardBorderBrush}" BorderThickness="1" CornerRadius="9">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="1"/>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="48" Height="48" Background="{StaticResource SetupAccentBackgroundBrush}" BorderBrush="#2A5963" BorderThickness="1" CornerRadius="7">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource SetupAccentBrush}" FontSize="17" FontWeight="Bold" Text="DB"/>
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SetupSectionTitleStyle}" Text="{x:Static properties:Resources.Setup_DatabaseTitle}"/>
                                    <TextBlock Margin="0,5,0,0" Style="{StaticResource SetupDescriptionStyle}" Text="{x:Static properties:Resources.Setup_DatabaseDescription}"/>
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="2" Background="{StaticResource SetupCardBorderBrush}"/>
                            <StackPanel Grid.Row="4">
                                <TextBlock Margin="0,0,0,8" Style="{StaticResource SetupLabelStyle}" Text="{x:Static properties:Resources.Setup_DatabaseConnectionLabel}"/>
                                <TextBox Style="{StaticResource SetupTextBoxStyle}" IsEnabled="{Binding CanModify}" Text="{Binding ConnectionString, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <Grid Grid.Row="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource SetupPrimaryButtonStyle}" Command="{Binding TestDatabaseConnectionCommand}" Content="{x:Static properties:Resources.Setup_TestDatabaseConnection}"/>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <ProgressBar Height="4" IsIndeterminate="True">
                                        <ProgressBar.Style>
                                            <Style TargetType="ProgressBar">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsTestingDatabase}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ProgressBar.Style>
                                    </ProgressBar>
                                    <TextBlock FontSize="13" Text="{Binding DatabaseStatusText}" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource SetupSecondaryTextBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDatabaseConnectionSuccessful}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource SetupSuccessBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsDatabaseConnectionSuccessful}" Value="False">
                                                        <Setter Property="Foreground" Value="{StaticResource SetupErrorBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                            <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource SetupPrimaryButtonStyle}" Command="{Binding ContinueCommand}" Content="{x:Static properties:Resources.Setup_Continue}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    </UserControl>

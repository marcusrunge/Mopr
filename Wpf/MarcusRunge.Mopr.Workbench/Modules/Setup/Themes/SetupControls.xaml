<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/MarcusRunge.Mopr.Workbench.Core;component/Themes/WorkbenchPalette.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <Style x:Key="SetupSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource WorkbenchTextBrush}" /><Setter Property="FontSize" Value="22" /><Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="SetupDescriptionStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource WorkbenchSecondaryTextBrush}" /><Setter Property="FontSize" Value="14" /><Setter Property="LineHeight" Value="21" /><Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SetupLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource WorkbenchTextBrush}" /><Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="SetupTextBoxStyle" TargetType="TextBox">
        <Setter Property="Height" Value="44" /><Setter Property="Padding" Value="12,8" />
        <Setter Property="Foreground" Value="{StaticResource WorkbenchTextBrush}" />
        <Setter Property="Background" Value="{StaticResource WorkbenchPanelBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource WorkbenchBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" /><Setter Property="CaretBrush" Value="{StaticResource WorkbenchAccentBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource WorkbenchAccentBrush}" /><Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{StaticResource WorkbenchAccentBrush}" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55" /></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="SetupPrimaryButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="40" /><Setter Property="MinWidth" Value="150" /><Setter Property="Padding" Value="18,7" />
        <Setter Property="Foreground" Value="{StaticResource WorkbenchBackgroundBrush}" /><Setter Property="Background" Value="{StaticResource WorkbenchAccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource WorkbenchAccentBrush}" /><Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource WorkbenchAccentHoverBrush}" /><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource WorkbenchAccentHoverBrush}" /></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource WorkbenchAccentPressedBrush}" /><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource WorkbenchAccentPressedBrush}" /></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource WorkbenchTextBrush}" /><Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.38" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SetupSecondaryButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="40" /><Setter Property="MinWidth" Value="130" /><Setter Property="Padding" Value="18,7" />
        <Setter Property="Foreground" Value="{StaticResource WorkbenchTextBrush}" /><Setter Property="Background" Value="{StaticResource WorkbenchSecondaryPanelBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource WorkbenchBorderBrush}" /><Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource WorkbenchControlHoverBackgroundBrush}" /><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource WorkbenchAccentBrush}" /></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource WorkbenchControlPressedBackgroundBrush}" /></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource WorkbenchAccentBrush}" /><Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.38" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SetupStepNumberStyle" TargetType="Border">
        <Setter Property="Width" Value="34" /><Setter Property="Height" Value="34" /><Setter Property="Background" Value="{StaticResource WorkbenchPanelBackgroundBrush}" /><Setter Property="BorderBrush" Value="{StaticResource WorkbenchBorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="17" />
    </Style>
    <Style x:Key="AdministrationCardStyle" TargetType="Border">
        <Setter Property="Margin" Value="0,0,16,16" /><Setter Property="Padding" Value="22" /><Setter Property="MinHeight" Value="132" /><Setter Property="Background" Value="{StaticResource WorkbenchPanelBackgroundBrush}" /><Setter Property="BorderBrush" Value="{StaticResource WorkbenchBorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style x:Key="AdministrationCardTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource WorkbenchTextBrush}" /><Setter Property="FontSize" Value="17" /><Setter Property="FontWeight" Value="SemiBold" />
    </Style>
</ResourceDictionary>

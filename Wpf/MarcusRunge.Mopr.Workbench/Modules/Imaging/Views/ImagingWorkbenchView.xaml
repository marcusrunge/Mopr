<UserControl x:Class="MarcusRunge.Mopr.Workbench.Modules.Imaging.Views.ImagingWorkbenchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:core="clr-namespace:MarcusRunge.Mopr.Workbench.Core;assembly=MarcusRunge.Mopr.Workbench.Core"
             xmlns:properties="clr-namespace:MarcusRunge.Mopr.Workbench.Modules.Imaging.Properties"
             xmlns:viewModels="clr-namespace:MarcusRunge.Mopr.Workbench.Modules.Imaging.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewModels:ImagingWorkbenchViewModel}"
             mc:Ignorable="d" prism:ViewModelLocator.AutoWireViewModel="True">
    
    <Grid Background="{StaticResource WorkbenchBackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="56" /><RowDefinition Height="52" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource WorkbenchHeaderBackgroundBrush}" BorderBrush="{StaticResource WorkbenchBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="40" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="32" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{x:Static properties:Resources.App_Title}" Foreground="{StaticResource WorkbenchTextBrush}" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding CurrentStudyDisplayText}" Foreground="{StaticResource WorkbenchTextBrush}" FontSize="18" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="{Binding CurrentSeriesDisplayText}" Foreground="{StaticResource WorkbenchTextBrush}" FontSize="18" VerticalAlignment="Center" />
                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Margin="0,0,8,0" Content="{x:Static properties:Resources.Workbench_Search}" />
                    <Button Width="40" Height="36" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Background="{StaticResource WorkbenchControlBackgroundBrush}" BorderBrush="{StaticResource WorkbenchBorderBrush}" BorderThickness="1"
                            FocusVisualStyle="{x:Null}" ToolTip="{x:Static properties:Resources.Workbench_SettingsAndAdministration}"
                            Command="{Binding DataContext.OpenAdministrationCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                        <Button.Template><ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{StaticResource WorkbenchTextBrush}" Text="&#xE713;" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource WorkbenchControlHoverBackgroundBrush}" /><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource WorkbenchAccentBorderBrush}" /></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource WorkbenchControlPressedBackgroundBrush}" /></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate></Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="{StaticResource WorkbenchCommandBarBackgroundBrush}" BorderBrush="{StaticResource WorkbenchBorderBrush}" BorderThickness="0,0,0,1">
            <ContentControl prism:RegionManager.RegionName="{x:Static core:RegionNames.ImagingCommandBarRegion}" />
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="{Binding SeriesPaneWidth}" /><ColumnDefinition Width="{Binding LeftSplitterWidth}" /><ColumnDefinition Width="*" /><ColumnDefinition Width="{Binding RightSplitterWidth}" /><ColumnDefinition Width="{Binding PropertiesPaneWidth}" /></Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Background="{StaticResource WorkbenchBackgroundBrush}">
                <Border Background="{StaticResource WorkbenchPanelBackgroundBrush}" BorderBrush="{StaticResource WorkbenchBorderBrush}" BorderThickness="0,0,1,0" Visibility="{Binding IsSeriesPaneVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DockPanel><Grid DockPanel.Dock="Top" Height="52" Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{x:Static properties:Resources.Workbench_Series}" Foreground="{StaticResource WorkbenchTextBrush}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" /><Button Grid.Column="1" Width="32" Height="32" Content="‹" Command="{Binding ToggleSeriesPaneCommand}" /></Grid><ContentControl prism:RegionManager.RegionName="{x:Static core:RegionNames.SeriesRegion}" /></DockPanel>
                </Border>
                <Border Background="{StaticResource WorkbenchPanelBackgroundBrush}" BorderBrush="{StaticResource WorkbenchBorderBrush}" BorderThickness="0,0,1,0" Visibility="{Binding IsSeriesPaneCollapsed, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button Command="{Binding ToggleSeriesPaneCommand}" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ToolTip="{x:Static properties:Resources.Workbench_ShowSeries}"><Grid><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="›" Foreground="{StaticResource WorkbenchAccentBrush}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,12" /><TextBlock Text="{x:Static properties:Resources.Workbench_Series}" Foreground="{StaticResource WorkbenchTextBrush}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"><TextBlock.LayoutTransform><RotateTransform Angle="-90" /></TextBlock.LayoutTransform></TextBlock></StackPanel></Grid></Button>
                </Border>
            </Grid>
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{StaticResource WorkbenchSplitterBrush}" Visibility="{Binding IsSeriesPaneVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Grid Grid.Column="2" Background="{StaticResource WorkbenchViewerBackgroundBrush}"><ContentControl prism:RegionManager.RegionName="{x:Static core:RegionNames.ViewerRegion}" /></Grid>
            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{StaticResource WorkbenchSplitterBrush}" Visibility="{Binding IsPropertiesPaneVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Grid Grid.Column="4" Background="{StaticResource WorkbenchBackgroundBrush}">
                <Border Background="{StaticResource WorkbenchPanelBackgroundBrush}" BorderBrush="{StaticResource WorkbenchBorderBrush}" BorderThickness="1,0,0,0" Visibility="{Binding IsPropertiesPaneVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DockPanel><Grid DockPanel.Dock="Top" Height="52" Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button Width="32" Height="32" Content="›" Margin="0,0,8,0" Command="{Binding TogglePropertiesPaneCommand}" /><TextBlock Grid.Column="1" Text="{x:Static properties:Resources.Workbench_Properties}" Foreground="{StaticResource WorkbenchTextBrush}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" /></Grid><ContentControl prism:RegionManager.RegionName="{x:Static core:RegionNames.PropertiesRegion}" /></DockPanel>
                </Border>
                <Border Background="{StaticResource WorkbenchPanelBackgroundBrush}" BorderBrush="{StaticResource WorkbenchBorderBrush}" BorderThickness="1,0,0,0" Visibility="{Binding IsPropertiesPaneCollapsed, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button Command="{Binding TogglePropertiesPaneCommand}" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ToolTip="Eigenschaften einblenden"><Grid><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="‹" Foreground="{StaticResource WorkbenchAccentBrush}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,12" /><TextBlock Text="Eigenschaften" Foreground="{StaticResource WorkbenchTextBrush}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"><TextBlock.LayoutTransform><RotateTransform Angle="90" /></TextBlock.LayoutTransform></TextBlock></StackPanel></Grid></Button>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

<UserControl x:Class="MarcusRunge.Mopr.Workbench.Modules.Imaging.Views.PropertiesPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:properties="clr-namespace:MarcusRunge.Mopr.Workbench.Modules.Imaging.Properties"
             xmlns:viewmodels="clr-namespace:MarcusRunge.Mopr.Workbench.Modules.Imaging.ViewModels"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             d:DataContext="{d:DesignInstance Type=viewmodels:PropertiesPanelViewModel}"
             mc:Ignorable="d"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <UserControl.Resources>

        <Style x:Key="MoprTabControlStyle"
           TargetType="{x:Type TabControl}">
            <Setter Property="Background"
                Value="Transparent" />
            <Setter Property="BorderThickness"
                Value="0" />
            <Setter Property="Padding"
                Value="0" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <primitives:TabPanel x:Name="HeaderPanel"
                                             Grid.Row="0"
                                             IsItemsHost="True"
                                             Margin="0,0,0,8"
                                             Background="Transparent"
                                             KeyboardNavigation.TabIndex="1"
                                             Panel.ZIndex="1" />

                            <Border Grid.Row="1"
                                Background="Transparent"
                                BorderThickness="0">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                              ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MoprTabItemStyle"
           TargetType="{x:Type TabItem}">
            <Setter Property="Foreground"
                Value="#8FA0AD" />
            <Setter Property="Background"
                Value="Transparent" />
            <Setter Property="BorderThickness"
                Value="0" />
            <Setter Property="Padding"
                Value="12,7,12,6" />
            <Setter Property="Margin"
                Value="0,0,8,0" />
            <Setter Property="FocusVisualStyle"
                Value="{x:Null}" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Grid>
                            <Border x:Name="Root"
                                Background="Transparent"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}"
                                TextElement.Foreground="{TemplateBinding Foreground}">

                                <ContentPresenter x:Name="ContentSite"
                                              ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                            </Border>

                            <Border x:Name="SelectedLine"
                                Height="2"
                                Background="Transparent"
                                VerticalAlignment="Bottom"
                                Margin="8,0,8,0"
                                CornerRadius="1" />
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                 Value="True">
                                <Setter TargetName="Root"
                                    Property="Background"
                                    Value="#10161C" />
                                <Setter Property="Foreground"
                                    Value="#DDE5EC" />
                            </Trigger>

                            <Trigger Property="IsSelected"
                                 Value="True">
                                <Setter TargetName="Root"
                                    Property="Background"
                                    Value="Transparent" />
                                <Setter TargetName="SelectedLine"
                                    Property="Background"
                                    Value="#60E1EB" />
                                <Setter Property="Foreground"
                                    Value="#E1F8FB" />
                                <Setter Property="FontWeight"
                                    Value="SemiBold" />
                            </Trigger>

                            <Trigger Property="IsEnabled"
                                 Value="False">
                                <Setter Property="Opacity"
                                    Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Kopf -->
        <Border Grid.Row="0"
                Padding="14,12"
                BorderBrush="#27313A"
                BorderThickness="0,0,0,1">

            <StackPanel>
                <TextBlock Text="{Binding Title}"
                           Foreground="#E1E8EF"
                           FontSize="16"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock Text="{Binding Subtitle}"
                           Foreground="#8FA0AD"
                           FontSize="12"
                           Margin="0,4,0,0"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <!-- Tabs -->

        <TabControl Grid.Row="1"
            Style="{StaticResource MoprTabControlStyle}"
            ItemContainerStyle="{StaticResource MoprTabItemStyle}"
            Margin="8">

            <!-- DICOM / Slice Eigenschaften -->
            <TabItem Header="{x:Static properties:Resources.PropertiesPanel_Tab_Dicom}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <ItemsControl ItemsSource="{Binding Properties}"
                                  Margin="4,8,4,4">

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">

                                    <!-- Section Header -->
                                    <Border x:Name="SectionBorder"
                                            Padding="2,10,0,4"
                                            Visibility="Collapsed">

                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="#7FDDE8"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Name}" />
                                    </Border>

                                    <!-- Property Row -->
                                    <Border x:Name="PropertyBorder"
                                            Padding="10"
                                            CornerRadius="6"
                                            Background="#141B22"
                                            BorderBrush="#27313A"
                                            BorderThickness="1"
                                            Visibility="Visible">

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Name}"
                                                       Foreground="#8FA0AD"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Name}" />

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Value}"
                                                       Foreground="#DDE5EC"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       ToolTip="{Binding Value}" />
                                        </Grid>
                                    </Border>
                                </Grid>

                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSection}"
                                                 Value="True">
                                        <Setter TargetName="SectionBorder"
                                                Property="Visibility"
                                                Value="Visible" />

                                        <Setter TargetName="PropertyBorder"
                                                Property="Visibility"
                                                Value="Collapsed" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <!-- Messungen -->
            <TabItem Header="{x:Static properties:Resources.PropertiesPanel_Tab_Measurements}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel Margin="4,8,4,4">

                        <Border Background="#141B22"
                                BorderBrush="#27313A"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10">

                            <StackPanel>

                                <TextBlock Text="{x:Static properties:Resources.Measurement_ListTitle}"
                                           Foreground="#7FDDE8"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8" />

                                <ListBox ItemsSource="{Binding ActiveMeasurements}"
                                         SelectedItem="{Binding SelectedMeasurement, Mode=TwoWay}"
                                         MinHeight="120"
                                         MaxHeight="220"
                                         Background="#0B1116"
                                         BorderBrush="#26333D"
                                         BorderThickness="1"
                                         Foreground="#DDE5EC"
                                         Padding="2">

                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment"
                                                    Value="Stretch" />
                                            <Setter Property="Padding"
                                                    Value="0" />
                                            <Setter Property="Margin"
                                                    Value="0,0,0,2" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>

                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,6"
                                                    CornerRadius="4"
                                                    Background="Transparent">

                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Text="{Binding DisplayTitle}"
                                                               Foreground="#DDE5EC"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding DisplayTitle}" />

                                                    <TextBlock Grid.Row="1"
                                                               Text="{Binding LabelText}"
                                                               Foreground="#8FA0AD"
                                                               FontSize="11"
                                                               Margin="0,2,0,0" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock Text="{x:Static properties:Resources.Measurement_SelectedTitle}"
                                           Foreground="#7FDDE8"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Margin="0,12,0,8" />

                                <StackPanel IsEnabled="{Binding HasSelectedMeasurement}">

                                    <TextBlock Text="{x:Static properties:Resources.Measurement_Title}"
                                               Foreground="#8FA0AD"
                                               FontSize="11" />

                                    <TextBox Text="{Binding SelectedMeasurement.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Background="#111A20"
                                             Foreground="#DDE5EC"
                                             BorderBrush="#26333D"
                                             BorderThickness="1"
                                             Margin="0,4,0,8"
                                             Padding="6,4" />

                                    <TextBlock Text="{x:Static properties:Resources.Measurement_Description}"
                                               Foreground="#8FA0AD"
                                               FontSize="11" />

                                    <TextBox Text="{Binding SelectedMeasurement.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Background="#111A20"
                                             Foreground="#DDE5EC"
                                             BorderBrush="#26333D"
                                             BorderThickness="1"
                                             Margin="0,4,0,8"
                                             Padding="6,4"
                                             MinHeight="70"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap" />

                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Margin="0,4,0,0">

                                        <Button Content="{x:Static properties:Resources.Measurement_Delete}"
                                                Command="{Binding DeleteSelectedMeasurementCommand}"
                                                Margin="0,0,8,0" />

                                        <Button Content="{x:Static properties:Resources.Measurement_ClearAll}"
                                                Command="{Binding ClearActiveMeasurementsCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
<UserControl x:Class="MarcusRunge.Mopr.Workbench.Modules.Setup.Views.Steps.VerificationSetupStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:properties="clr-namespace:MarcusRunge.Mopr.Workbench.Modules.Setup.Properties"
             d:DesignHeight="520"
             d:DesignWidth="788"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MarcusRunge.Mopr.Workbench.Modules.Setup;component/Themes/SetupControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Padding="32"
            VerticalAlignment="Top"
            Background="{StaticResource SetupCardBackgroundBrush}"
            BorderBrush="{StaticResource SetupCardBorderBrush}"
            BorderThickness="1"
            CornerRadius="9">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="1" />
                <RowDefinition Height="24" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Width="48"
                        Height="48"
                        Background="{StaticResource SetupAccentBackgroundBrush}"
                        BorderBrush="#2A5963"
                        BorderThickness="1"
                        CornerRadius="7">

                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource SetupAccentBrush}"
                               FontSize="15"
                               FontWeight="Bold"
                               Text="CHK" />
                </Border>

                <StackPanel Grid.Column="2"
                            VerticalAlignment="Center">

                    <TextBlock Style="{StaticResource SetupSectionTitleStyle}"
                               Text="{x:Static properties:Resources.Setup_VerificationTitle}" />

                    <TextBlock Margin="0,5,0,0"
                               Style="{StaticResource SetupDescriptionStyle}"
                               Text="{x:Static properties:Resources.Setup_VerificationDescription}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="2"
                    Background="{StaticResource SetupCardBorderBrush}" />

            <Border Grid.Row="4"
                    Padding="16"
                    Background="#14232B"
                    BorderBrush="{StaticResource SetupCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Style="{StaticResource SetupLabelStyle}"
                                   Text="{x:Static properties:Resources.Setup_DatabaseTitle}" />

                        <TextBlock Margin="0,6,0,0"
                                   Foreground="{StaticResource SetupSecondaryTextBrush}"
                                   FontSize="13"
                                   Text="{Binding ConnectionString}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding ConnectionString}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Ellipse Width="8"
                                 Height="8"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center"
                                 Fill="{StaticResource SetupSuccessBrush}" />

                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{StaticResource SetupSuccessBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Text="{x:Static properties:Resources.Setup_Verified}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="6"
                    Padding="16"
                    Background="#14232B"
                    BorderBrush="{StaticResource SetupCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Style="{StaticResource SetupLabelStyle}"
                                   Text="{x:Static properties:Resources.Setup_RepositoryTitle}" />

                        <TextBlock Margin="0,6,0,0"
                                   Foreground="{StaticResource SetupSecondaryTextBrush}"
                                   FontSize="13"
                                   Text="{Binding RepositoryLocationPath}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding RepositoryLocationPath}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Ellipse Width="8"
                                 Height="8"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center"
                                 Fill="{StaticResource SetupSuccessBrush}" />

                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{StaticResource SetupSuccessBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Text="{x:Static properties:Resources.Setup_Verified}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock VerticalAlignment="Center"
                           Foreground="{StaticResource SetupSecondaryTextBrush}"
                           FontSize="12"
                           Text="{x:Static properties:Resources.Setup_VerificationNoChangesNotice}"
                           TextWrapping="Wrap" />

                <StackPanel Grid.Column="1"
                            Margin="24,0,0,0"
                            Orientation="Horizontal">

                    <Button Margin="0,0,12,0"
                            Style="{StaticResource SetupSecondaryButtonStyle}"
                            Command="{Binding BackCommand}"
                            Content="{x:Static properties:Resources.Setup_Back}" />

                    <Button Style="{StaticResource SetupPrimaryButtonStyle}"
                            Command="{Binding ContinueCommand}"
                            Content="{x:Static properties:Resources.Setup_Continue}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
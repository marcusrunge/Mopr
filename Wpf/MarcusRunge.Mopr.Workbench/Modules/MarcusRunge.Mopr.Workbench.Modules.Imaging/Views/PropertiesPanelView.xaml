<UserControl x:Class="MarcusRunge.Mopr.Workbench.Modules.Imaging.Views.PropertiesPanelView"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:viewmodels="clr-namespace:MarcusRunge.Mopr.Workbench.Modules.Imaging.ViewModels"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             d:DataContext="{d:DesignInstance Type=viewmodels:PropertiesPanelViewModel}"
             mc:Ignorable="d"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <Grid Background="Transparent">

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12">

                <!-- Window / Level -->
                <Expander Header="Window / Level"
                          IsExpanded="True"
                          Margin="0,0,0,8">

                    <StackPanel Margin="0,10,0,12">

                        <TextBlock Text="Window"
                                   FontSize="13"
                                   Foreground="#9BA7B3"
                                   Margin="0,0,0,4" />

                        <Slider Minimum="1"
                                Maximum="4000"
                                Value="{Binding WindowValue}"
                                IsMoveToPointEnabled="True" />

                        <TextBlock Text="{Binding WindowDisplayText}"
                                   FontSize="12"
                                   Foreground="#DDE5EC"
                                   Margin="0,2,0,10" />

                        <TextBlock Text="Level"
                                   FontSize="13"
                                   Foreground="#9BA7B3"
                                   Margin="0,0,0,4" />

                        <Slider Minimum="-1000"
                                Maximum="3000"
                                Value="{Binding LevelValue}"
                                IsMoveToPointEnabled="True" />

                        <TextBlock Text="{Binding LevelDisplayText}"
                                   FontSize="12"
                                   Foreground="#DDE5EC"
                                   Margin="0,2,0,10" />

                        <Button Content="Reset Window/Level"
                                Command="{Binding ResetWindowLevelCommand}"
                                HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Expander>

                <!-- Messungen -->
                <Expander Header="Messungen"
                          IsExpanded="True"
                          Margin="0,0,0,8">

                    <Grid Margin="0,10,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0"
                                    Orientation="Horizontal"
                                    Margin="0,0,0,8">

                            <Button Content="Distanz"
                                    Command="{Binding AddDistanceMeasurementCommand}"
                                    Margin="0,0,6,0" />

                            <Button Content="Winkel"
                                    Command="{Binding AddAngleMeasurementCommand}"
                                    Margin="0,0,6,0" />

                            <Button Content="ROI"
                                    Command="{Binding AddRoiMeasurementCommand}" />
                        </StackPanel>

                        <ItemsControl Grid.Row="1"
                                      ItemsSource="{Binding Measurements}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8"
                                            Margin="0,0,0,6"
                                            CornerRadius="6"
                                            Background="#141B22"
                                            BorderBrush="#27313A"
                                            BorderThickness="1">

                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#E1E8EF" />

                                            <TextBlock Text="{Binding Value}"
                                                       FontSize="12"
                                                       Foreground="#9BA7B3"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Expander>

                <!-- Annotationen -->
                <Expander Header="Annotationen"
                          Margin="0,0,0,8">

                    <StackPanel Margin="0,10,0,12">

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,8">

                            <Button Content="Text"
                                    Command="{Binding AddTextAnnotationCommand}"
                                    Margin="0,0,6,0" />

                            <Button Content="Pfeil"
                                    Command="{Binding AddArrowAnnotationCommand}"
                                    Margin="0,0,6,0" />

                            <Button Content="Marker"
                                    Command="{Binding AddMarkerAnnotationCommand}" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Annotations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8"
                                            Margin="0,0,0,6"
                                            CornerRadius="6"
                                            Background="#141B22"
                                            BorderBrush="#27313A"
                                            BorderThickness="1">

                                        <TextBlock Text="{Binding DisplayText}"
                                                   FontSize="12"
                                                   Foreground="#DDE5EC" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>

                <!-- DICOM Tags -->
                <Expander Header="DICOM-Tags"
                          Margin="0,0,0,8">

                    <DataGrid Margin="0,10,0,12"
                              ItemsSource="{Binding DicomTags}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              BorderThickness="0"
                              Background="Transparent">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tag"
                                                Binding="{Binding Tag}"
                                                Width="Auto" />

                            <DataGridTextColumn Header="Name"
                                                Binding="{Binding Name}"
                                                Width="*" />

                            <DataGridTextColumn Header="Wert"
                                                Binding="{Binding Value}"
                                                Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
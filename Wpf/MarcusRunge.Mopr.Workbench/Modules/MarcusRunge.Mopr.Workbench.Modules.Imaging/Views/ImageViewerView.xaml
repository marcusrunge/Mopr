<UserControl x:Class="MarcusRunge.Mopr.Workbench.Modules.Imaging.Views.ImageViewerView"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:viewmodels="clr-namespace:MarcusRunge.Mopr.Workbench.Modules.Imaging.ViewModels"
             xmlns:viewports="clr-namespace:MarcusRunge.Mopr.Workbench.Modules.Imaging.Views.Viewports"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             d:DataContext="{d:DesignInstance Type=viewmodels:ImageViewerViewModel}"
             mc:Ignorable="d"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <Grid Background="#030506"
          ClipToBounds="True">

        <Border Background="#05080A"
                BorderBrush="#1F2933"
                BorderThickness="1"
                Margin="16">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="42"/>
                </Grid.RowDefinitions>

                <!-- Viewport-Fläche ohne störende globale Overlays -->
                <viewports:ViewportLayoutHost Grid.Row="0"/>

                <!-- Saubere Statusleiste unten -->
                <Border Grid.Row="1"
                        Background="#10161C"
                        BorderBrush="#1F2933"
                        BorderThickness="0,1,0,0"
                        Padding="12,0">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Serie -->
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <TextBlock Text="{Binding ViewerTitle}"
                                       Foreground="#DDE5EC"
                                       FontWeight="SemiBold"
                                       FontSize="13"/>

                            <TextBlock Text=" · "
                                       Foreground="#596673"
                                       Margin="6,0"/>

                            <TextBlock Text="{Binding ViewerSubtitle}"
                                       Foreground="#8FA0AD"
                                       FontSize="12"/>                            

                        </StackPanel>

                        <!-- Aktiver Viewport -->
                        <TextBlock Grid.Column="2"
                                   Text="{Binding ActiveViewportDisplayText}"
                                   Foreground="#8FA0AD"
                                   VerticalAlignment="Center"
                                   FontSize="12"/>

                        <!-- Werkzeug -->
                        <TextBlock Grid.Column="4"
                                   Text="{Binding ActiveToolDisplayText}"
                                   Foreground="#7FDDE8"
                                   VerticalAlignment="Center"
                                   FontSize="12"/>

                        <!-- Layout -->
                        <TextBlock Grid.Column="6"
                                   Text="{Binding LayoutDisplayText}"
                                   Foreground="#8FA0AD"
                                   VerticalAlignment="Center"
                                   FontSize="12"/>

                        <!-- Zoom -->
                        <StackPanel Grid.Column="8"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <TextBlock Text="Zoom"
                                       Foreground="#8FA0AD"
                                       Margin="0,0,6,0"/>

                            <TextBlock Text="{Binding ZoomDisplayText}"
                                       Foreground="#DDE5EC"
                                       FontWeight="SemiBold"/>

                        </StackPanel>

                        <!-- Slice Slider -->
                        <Slider Grid.Column="10"
                                VerticalAlignment="Center"
                                Minimum="1"
                                Maximum="{Binding SliceCount}"
                                Value="{Binding CurrentSlice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                IsMoveToPointEnabled="True"/>

                        <!-- Slice Text -->
                        <TextBlock Grid.Column="12"
                                   Text="{Binding SliceDisplayText}"
                                   Foreground="#DDE5EC"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>

                    </Grid>
                </Border>

            </Grid>
        </Border>
    </Grid>
</UserControl>
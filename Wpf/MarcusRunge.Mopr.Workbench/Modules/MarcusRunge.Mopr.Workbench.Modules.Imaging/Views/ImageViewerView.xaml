<UserControl x:Class="MarcusRunge.Mopr.Workbench.Modules.Imaging.Views.ImageViewerView"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prism="http://prismlibrary.com/" 
             xmlns:viewmodels="clr-namespace:MarcusRunge.Mopr.Workbench.Modules.Imaging.ViewModels"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             d:DataContext="{d:DesignInstance Type=viewmodels:ImageViewerViewModel}"
             mc:Ignorable="d"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <Grid Background="#030506"
          ClipToBounds="True">

        <!-- Viewer-Fläche -->
        <Border Background="#05080A"
                BorderBrush="#1F2933"
                BorderThickness="1"
                Margin="16">

            <Grid>

                <!-- Später: echtes DICOM-/MPR-Bild -->
                <Image Source="{Binding CurrentImage}"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <!-- Fallback, wenn noch kein Bild geladen ist -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsEmptyViewerVisible, Converter={StaticResource BooleanToVisibilityConverter}}">

                    <TextBlock Text="Kein Bild geladen"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="#7D8790"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Öffne eine Studie oder Serie, um den Viewer zu starten."
                               FontSize="15"
                               Foreground="#58636E"
                               Margin="0,8,0,0"
                               HorizontalAlignment="Center"/>

                </StackPanel>

                <!-- Obere Viewer-Toolbar -->
                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,12,0,0"
                        Padding="8"
                        CornerRadius="8"
                        Background="#AA11171D"
                        BorderBrush="#33414D"
                        BorderThickness="1">

                    <StackPanel Orientation="Horizontal">

                        <Button Content="Zoom"
                                Command="{Binding ZoomCommand}"
                                Margin="0,0,6,0"/>

                        <Button Content="Pan"
                                Command="{Binding PanCommand}"
                                Margin="0,0,6,0"/>

                        <Button Content="WL"
                                Command="{Binding WindowLevelCommand}"
                                Margin="0,0,6,0"/>

                        <Button Content="Crosshair"
                                Command="{Binding CrosshairCommand}"
                                Margin="0,0,6,0"/>

                        <Button Content="Reset"
                                Command="{Binding ResetViewCommand}"/>

                    </StackPanel>
                </Border>

                <!-- Linke obere Statusinfo -->
                <Border HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="12"
                        Padding="10,6"
                        CornerRadius="6"
                        Background="#99000000">

                    <StackPanel>
                        <TextBlock Text="{Binding ViewerTitle}"
                                   Foreground="#DDE5EC"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="{Binding ViewerSubtitle}"
                                   Foreground="#9BA7B3"
                                   FontSize="12"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Rechte Slice-Anzeige -->
                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0"
                        Padding="8"
                        CornerRadius="6"
                        Background="#66000000">

                    <StackPanel>
                        <Slider Orientation="Vertical"
                                Height="220"
                                Minimum="1"
                                Maximum="{Binding SliceCount}"
                                Value="{Binding CurrentSlice}"
                                IsMoveToPointEnabled="True"/>

                        <TextBlock Text="{Binding SliceDisplayText}"
                                   Foreground="#DDE5EC"
                                   FontSize="13"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Untere Zoom-Anzeige -->
                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,12"
                        Padding="10,6"
                        CornerRadius="6"
                        Background="#66000000">

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Zoom"
                                   Foreground="#9BA7B3"
                                   Margin="0,0,8,0"/>

                        <TextBlock Text="{Binding ZoomDisplayText}"
                                   Foreground="#DDE5EC"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

            </Grid>
        </Border>
    </Grid>
</UserControl>
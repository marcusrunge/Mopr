<UserControl x:Class="MarcusRunge.Mopr.Workbench.Modules.Imaging.Views.SeriesPanelView"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:viewmodels="clr-namespace:MarcusRunge.Mopr.Workbench.Modules.Imaging.ViewModels"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             d:DataContext="{d:DesignInstance Type=viewmodels:SeriesPanelViewModel}"
             mc:Ignorable="d"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <Grid Background="Transparent">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Suche / Filter -->
        <Border Grid.Row="0"
                Margin="12,8,12,8">

            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Height="34"
                     VerticalContentAlignment="Center"
                     Padding="10,0"
                     ToolTip="Serien filtern" />
        </Border>

        <!-- Serienliste -->
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Series}"
                 SelectedItem="{Binding SelectedSeries}"
                 BorderThickness="0"
                 Background="Transparent"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 HorizontalContentAlignment="Stretch">

            <!-- Zeilenhintergrund / Selection / MouseOver -->
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="Height" Value="112" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />

                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="RowBackground"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        SnapsToDevicePixels="True">

                                    <ContentPresenter HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Center" />
                                </Border>

                                <ControlTemplate.Triggers>
                                    <!-- Hover-Reihenhintergrund -->
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="RowBackground"
                                                Property="Background"
                                                Value="#10232A" />
                                    </Trigger>

                                    <!-- Aktive Reihe wie im Screenshot -->
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="RowBackground"
                                                Property="Background"
                                                Value="#176B78" />
                                    </Trigger>

                                    <!-- Hover auf aktiver Reihe -->
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsSelected" Value="True" />
                                            <Condition Property="IsMouseOver" Value="True" />
                                        </MultiTrigger.Conditions>

                                        <Setter TargetName="RowBackground"
                                                Property="Background"
                                                Value="#1D7B89" />
                                    </MultiTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>

                    <!-- Dunkle Card innerhalb der ListBox-Zeile -->
                    <Border Margin="20,14,20,14"
                            Height="84"
                            Padding="10"
                            CornerRadius="8"
                            BorderBrush="#27313A"
                            BorderThickness="1"
                            Background="#141B22"
                            HorizontalAlignment="Stretch"
                            ClipToBounds="True">

                        <Grid ClipToBounds="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Thumbnail-Platzhalter -->
                            <Border Grid.Column="0"
                                    Width="44"
                                    Height="44"
                                    CornerRadius="6"
                                    Background="#05080A"
                                    BorderBrush="#35414C"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">

                                <TextBlock Text="{Binding Modality}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#B8C4CF"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Modality}" />
                            </Border>

                            <!-- Serieninformationen -->
                            <Grid Grid.Column="1"
                                  Margin="10,0,0,0"
                                  VerticalAlignment="Center"
                                  MinWidth="0"
                                  ClipToBounds="True">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="{Binding Name}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#E1E8EF"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Name}" />

                                <TextBlock Grid.Row="1"
                                           Text="{Binding Description}"
                                           FontSize="12"
                                           Foreground="#94A1AD"
                                           Margin="0,3,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Description}" />

                                <TextBlock Grid.Row="2"
                                           Text="{Binding ImageCountDisplayText}"
                                           FontSize="12"
                                           Foreground="#6F7B86"
                                           Margin="0,3,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding ImageCountDisplayText}" />
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
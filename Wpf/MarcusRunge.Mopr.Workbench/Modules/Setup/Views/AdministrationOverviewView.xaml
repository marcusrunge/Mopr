<UserControl x:Class="MarcusRunge.Mopr.Workbench.Modules.Setup.Views.AdministrationOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:properties="clr-namespace:MarcusRunge.Mopr.Workbench.Modules.Setup.Properties"
             xmlns:viewmodels="clr-namespace:MarcusRunge.Mopr.Workbench.Modules.Setup.ViewModels"
             xmlns:views="clr-namespace:MarcusRunge.Mopr.Workbench.Modules.Setup.Views"
             d:DataContext="{d:DesignInstance Type=viewmodels:AdministrationOverviewViewModel}"
             mc:Ignorable="d"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MarcusRunge.Mopr.Workbench.Modules.Setup;component/Themes/SetupControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="AdministrationNavigationButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="46" /><Setter Property="Margin" Value="0,0,0,5" /><Setter Property="Padding" Value="14,0" />
                <Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{StaticResource WorkbenchSecondaryTextBrush}" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="Normal" /><Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="NavigationButtonBorder" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" SnapsToDevicePixels="True"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}" /></Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavigationButtonBorder" Property="Background" Value="{StaticResource WorkbenchControlHoverBackgroundBrush}" /><Setter TargetName="NavigationButtonBorder" Property="BorderBrush" Value="{StaticResource WorkbenchAccentBorderBrush}" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="NavigationButtonBorder" Property="Background" Value="{StaticResource WorkbenchControlPressedBackgroundBrush}" /><Setter TargetName="NavigationButtonBorder" Property="BorderBrush" Value="{StaticResource WorkbenchAccentBrush}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="NavigationButtonBorder" Property="Opacity" Value="0.55" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{StaticResource WorkbenchBackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="56" /><RowDefinition Height="52" /><RowDefinition Height="*" /><RowDefinition Height="44" /></Grid.RowDefinitions>
        <Border Grid.Row="0"
                Background="{StaticResource WorkbenchHeaderBackgroundBrush}"
                BorderBrush="{StaticResource WorkbenchBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource WorkbenchTextBrush}" FontSize="24" FontWeight="SemiBold" Text="{x:Static properties:Resources.Administration_Title}" />
                <Button Grid.Column="1" Height="36" MinWidth="168" VerticalAlignment="Center" Style="{StaticResource SetupSecondaryButtonStyle}" Command="{Binding ReturnToImagingCommand}" Content="{Binding ReturnToImagingText}" />
            </Grid>
        </Border>
        <Border Grid.Row="1"
                Background="{StaticResource WorkbenchCommandBarBackgroundBrush}"
                BorderBrush="{StaticResource WorkbenchBorderBrush}"
                BorderThickness="0,0,0,1">
            <TextBlock Margin="16,0" VerticalAlignment="Center" Foreground="{StaticResource WorkbenchSecondaryTextBrush}" FontSize="13" Text="{x:Static properties:Resources.Administration_PrototypeNotice}" />
        </Border>
        <Grid Grid.Row="2" Margin="48,28,48,32" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions><ColumnDefinition Width="252" /><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Padding="12" Background="{StaticResource WorkbenchSecondaryPanelBackgroundBrush}" BorderBrush="{StaticResource WorkbenchBorderBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel><TextBlock Margin="8,5,8,16" Foreground="{StaticResource WorkbenchMutedTextBrush}" FontSize="11" FontWeight="Bold" Text="{x:Static properties:Resources.Administration_Settings}" />
<Button Command="{Binding SelectSectionCommand}" CommandParameter="Overview" Content="{x:Static properties:Resources.Administration_Overview}"><Button.Style><Style BasedOn="{StaticResource AdministrationNavigationButtonStyle}" TargetType="Button"><Style.Triggers><DataTrigger Binding="{Binding IsOverviewSelected}" Value="True"><Setter Property="Foreground" Value="{StaticResource WorkbenchAccentBrush}" /><Setter Property="Background" Value="{StaticResource WorkbenchAccentBackgroundBrush}" /><Setter Property="BorderBrush" Value="{StaticResource WorkbenchAccentBorderBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Command="{Binding SelectSectionCommand}" CommandParameter="Database" Content="{x:Static properties:Resources.Administration_Database}"><Button.Style><Style BasedOn="{StaticResource AdministrationNavigationButtonStyle}" TargetType="Button"><Style.Triggers><DataTrigger Binding="{Binding IsDatabaseSelected}" Value="True"><Setter Property="Foreground" Value="{StaticResource WorkbenchAccentBrush}" /><Setter Property="Background" Value="{StaticResource WorkbenchAccentBackgroundBrush}" /><Setter Property="BorderBrush" Value="{StaticResource WorkbenchAccentBorderBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Command="{Binding SelectSectionCommand}" CommandParameter="Repository" Content="{x:Static properties:Resources.Administration_Repository}"><Button.Style><Style BasedOn="{StaticResource AdministrationNavigationButtonStyle}" TargetType="Button"><Style.Triggers><DataTrigger Binding="{Binding IsRepositorySelected}" Value="True"><Setter Property="Foreground" Value="{StaticResource WorkbenchAccentBrush}" /><Setter Property="Background" Value="{StaticResource WorkbenchAccentBackgroundBrush}" /><Setter Property="BorderBrush" Value="{StaticResource WorkbenchAccentBorderBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Command="{Binding SelectSectionCommand}" CommandParameter="Security" Content="{x:Static properties:Resources.Administration_Security}"><Button.Style><Style BasedOn="{StaticResource AdministrationNavigationButtonStyle}" TargetType="Button"><Style.Triggers><DataTrigger Binding="{Binding IsSecuritySelected}" Value="True"><Setter Property="Foreground" Value="{StaticResource WorkbenchAccentBrush}" /><Setter Property="Background" Value="{StaticResource WorkbenchAccentBackgroundBrush}" /><Setter Property="BorderBrush" Value="{StaticResource WorkbenchAccentBorderBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Command="{Binding SelectSectionCommand}" CommandParameter="Users" Content="{x:Static properties:Resources.Administration_Users}"><Button.Style><Style BasedOn="{StaticResource AdministrationNavigationButtonStyle}" TargetType="Button"><Style.Triggers><DataTrigger Binding="{Binding IsUsersSelected}" Value="True"><Setter Property="Foreground" Value="{StaticResource WorkbenchAccentBrush}" /><Setter Property="Background" Value="{StaticResource WorkbenchAccentBackgroundBrush}" /><Setter Property="BorderBrush" Value="{StaticResource WorkbenchAccentBorderBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Command="{Binding SelectSectionCommand}" CommandParameter="SystemCheck" Content="{x:Static properties:Resources.Administration_SystemCheck}"><Button.Style><Style BasedOn="{StaticResource AdministrationNavigationButtonStyle}" TargetType="Button"><Style.Triggers><DataTrigger Binding="{Binding IsSystemCheckSelected}" Value="True"><Setter Property="Foreground" Value="{StaticResource WorkbenchAccentBrush}" /><Setter Property="Background" Value="{StaticResource WorkbenchAccentBackgroundBrush}" /><Setter Property="BorderBrush" Value="{StaticResource WorkbenchAccentBorderBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers></Style></Button.Style></Button></StackPanel></Border>
            <Border Grid.Column="2" Background="{StaticResource WorkbenchPanelBackgroundBrush}" BorderBrush="{StaticResource WorkbenchBorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                <Grid>
                    <ScrollViewer Visibility="{Binding OverviewVisibility}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><StackPanel Margin="30"><TextBlock Style="{StaticResource SetupSectionTitleStyle}" Text="{x:Static properties:Resources.Administration_Overview}" /><TextBlock Margin="0,9,0,26" Style="{StaticResource SetupDescriptionStyle}" Text="{x:Static properties:Resources.Administration_OverviewDescription}" /><UniformGrid Columns="2">
                        <Border Style="{StaticResource AdministrationCardStyle}"><StackPanel><TextBlock Style="{StaticResource AdministrationCardTitleStyle}" Text="{x:Static properties:Resources.Administration_Database}" /><TextBlock Margin="0,8,0,0" Style="{StaticResource SetupDescriptionStyle}" Text="{x:Static properties:Resources.Administration_DatabaseDescription}" /></StackPanel></Border>
                        <Border Style="{StaticResource AdministrationCardStyle}"><StackPanel><TextBlock Style="{StaticResource AdministrationCardTitleStyle}" Text="{x:Static properties:Resources.Administration_Repository}" /><TextBlock Margin="0,8,0,0" Style="{StaticResource SetupDescriptionStyle}" Text="{x:Static properties:Resources.Administration_RepositoryDescription}" /></StackPanel></Border>
                        <Border Style="{StaticResource AdministrationCardStyle}"><StackPanel><TextBlock Style="{StaticResource AdministrationCardTitleStyle}" Text="{x:Static properties:Resources.Administration_Security}" /><TextBlock Margin="0,8,0,0" Style="{StaticResource SetupDescriptionStyle}" Text="{x:Static properties:Resources.Administration_SecurityDescription}" /></StackPanel></Border>
                        <Border Style="{StaticResource AdministrationCardStyle}"><StackPanel><TextBlock Style="{StaticResource AdministrationCardTitleStyle}" Text="{x:Static properties:Resources.Administration_Users}" /><TextBlock Margin="0,8,0,0" Style="{StaticResource SetupDescriptionStyle}" Text="{x:Static properties:Resources.Administration_UsersDescription}" /></StackPanel></Border>
                    </UniformGrid></StackPanel></ScrollViewer>
                    <Grid Visibility="{Binding DatabaseVisibility}"><views:DatabaseAdministrationView /></Grid><Grid Visibility="{Binding RepositoryVisibility}"><views:RepositoryAdministrationView /></Grid>
                    <ScrollViewer Visibility="{Binding SecurityVisibility}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><StackPanel Margin="30"><TextBlock Style="{StaticResource SetupSectionTitleStyle}" Text="{x:Static properties:Resources.Administration_Security}" /><TextBlock Margin="0,9,0,0" Style="{StaticResource SetupDescriptionStyle}" Text="{x:Static properties:Resources.Administration_SecurityDescription}" /></StackPanel></ScrollViewer>
                    <ScrollViewer Visibility="{Binding UsersVisibility}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><StackPanel Margin="30"><TextBlock Style="{StaticResource SetupSectionTitleStyle}" Text="{x:Static properties:Resources.Administration_Users}" /><TextBlock Margin="0,9,0,0" Style="{StaticResource SetupDescriptionStyle}" Text="{x:Static properties:Resources.Administration_UsersDescription}" /></StackPanel></ScrollViewer>
                    <ScrollViewer Visibility="{Binding SystemCheckVisibility}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><StackPanel Margin="30"><TextBlock Style="{StaticResource SetupSectionTitleStyle}" Text="{x:Static properties:Resources.Administration_SystemCheck}" /><TextBlock Margin="0,9,0,0" Style="{StaticResource SetupDescriptionStyle}" Text="{x:Static properties:Resources.Administration_SystemCheckDescription}" /></StackPanel></ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="3" Background="{StaticResource WorkbenchFooterBackgroundBrush}" BorderBrush="{StaticResource WorkbenchBorderBrush}" BorderThickness="0,1,0,0"><TextBlock Margin="48,0" VerticalAlignment="Center" Foreground="{StaticResource WorkbenchMutedTextBrush}" FontSize="11" Text="{x:Static properties:Resources.Administration_AdministratorAccessActive}" /></Border>
    </Grid>
</UserControl>
<UserControl x:Class="MarcusRunge.Mopr.Workbench.Modules.Imaging.Views.PropertiesPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:MarcusRunge.Mopr.Workbench.Modules.Imaging.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:PropertiesPanelViewModel}"
             mc:Ignorable="d"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Kopf -->
        <Border Grid.Row="0"
                Padding="14,12"
                BorderBrush="#27313A"
                BorderThickness="0,0,0,1">

            <StackPanel>
                <TextBlock Text="{Binding Title}"
                           Foreground="#E1E8EF"
                           FontSize="16"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock Text="{Binding Subtitle}"
                           Foreground="#8FA0AD"
                           FontSize="12"
                           Margin="0,4,0,0"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <!-- Eigenschaften -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <ItemsControl ItemsSource="{Binding Properties}"
                          Margin="12">

                <ItemsControl.ItemTemplate>
                    <DataTemplate>

                        <Grid Margin="0,0,0,8">

                            <!-- Section Header -->
                            <Border x:Name="SectionBorder"
                                    Padding="2,10,0,4"
                                    Visibility="Collapsed">

                                <TextBlock Text="{Binding Name}"
                                           Foreground="#7FDDE8"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Name}" />
                            </Border>

                            <!-- Property Row -->
                            <Border x:Name="PropertyBorder"
                                    Padding="10"
                                    CornerRadius="6"
                                    Background="#141B22"
                                    BorderBrush="#27313A"
                                    BorderThickness="1"
                                    Visibility="Visible">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Name}"
                                               Foreground="#8FA0AD"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Name}" />

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Value}"
                                               Foreground="#DDE5EC"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               ToolTip="{Binding Value}" />
                                </Grid>
                            </Border>
                        </Grid>

                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSection}" Value="True">
                                <Setter TargetName="SectionBorder"
                                        Property="Visibility"
                                        Value="Visible" />
                                <Setter TargetName="PropertyBorder"
                                        Property="Visibility"
                                        Value="Collapsed" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
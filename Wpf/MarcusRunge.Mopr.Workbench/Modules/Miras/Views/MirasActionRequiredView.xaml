<UserControl x:Class="MarcusRunge.Mopr.Workbench.Modules.Miras.Views.MirasActionRequiredView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:properties="clr-namespace:MarcusRunge.Mopr.Workbench.Modules.Miras.Properties"
             xmlns:viewModels="clr-namespace:MarcusRunge.Mopr.Workbench.Modules.Miras.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewModels:MirasActionRequiredViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="1280"
             mc:Ignorable="d"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <Grid Background="#10171D">
        <Grid.RowDefinitions>
            <RowDefinition Height="112" />
            <RowDefinition Height="*" />
            <RowDefinition Height="44" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="#151E26"
                BorderBrush="#2B3B47"
                BorderThickness="0,0,0,1">

            <Grid Margin="48,0">
                <StackPanel VerticalAlignment="Center">
                    <Border Padding="9,4"
                            HorizontalAlignment="Left"
                            Background="#3A2F18"
                            BorderBrush="#665329"
                            BorderThickness="1"
                            CornerRadius="4">

                        <TextBlock Foreground="#F2C14E"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Text="{x:Static properties:Resources.MirasActionRequiredBadge}" />
                    </Border>

                    <TextBlock Margin="0,10,0,0"
                               Foreground="#E6EDF2"
                               FontSize="27"
                               FontWeight="SemiBold"
                               Text="{Binding Title}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Protected recovery area -->
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">

            <Grid Width="820"
                  Margin="48"
                  HorizontalAlignment="Center">

                <Border Padding="36"
                        VerticalAlignment="Center"
                        Background="#18232D"
                        BorderBrush="#665329"
                        BorderThickness="1"
                        CornerRadius="8">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Warning indicator -->
                        <Border Width="56"
                                Height="56"
                                VerticalAlignment="Top"
                                Background="#3A2F18"
                                BorderBrush="#665329"
                                BorderThickness="1"
                                CornerRadius="28">

                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#F2C14E"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Text="!" />
                        </Border>

                        <StackPanel Grid.Column="2">
                            <TextBlock Foreground="#E6EDF2"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Text="{Binding Title}"
                                       TextWrapping="Wrap" />

                            <TextBlock Margin="0,14,0,0"
                                       Foreground="#A6B4BF"
                                       FontSize="14"
                                       LineHeight="22"
                                       Text="{Binding Description}"
                                       TextWrapping="Wrap" />

                            <!-- Safety notice -->
                            <Border Margin="0,24,0,0"
                                    Padding="16"
                                    Background="#141E26"
                                    BorderBrush="#2B3B47"
                                    BorderThickness="1"
                                    CornerRadius="6">

                                <TextBlock Foreground="#A6B4BF"
                                           FontSize="13"
                                           LineHeight="20"
                                           Text="{x:Static properties:Resources.MirasActionRequiredSafetyNotice}"
                                           TextWrapping="Wrap" />
                            </Border>

                            <!-- Administrative authorization warning -->
                            <Border Margin="0,20,0,0"
                                    Padding="16"
                                    Background="#3A2F18"
                                    BorderBrush="#665329"
                                    BorderThickness="1"
                                    CornerRadius="6">

                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility"
                                                Value="Collapsed" />

                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasAdministrativeAuthorization}"
                                                         Value="False">

                                                <Setter Property="Visibility"
                                                        Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <TextBlock Foreground="#F2C14E"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           LineHeight="20"
                                           Text="{x:Static properties:Resources.MirasActionRequiredAdministratorRequired}"
                                           TextWrapping="Wrap" />
                            </Border>

                            <!-- Recovery controls -->
                            <Border Margin="0,24,0,0"
                                    Padding="20"
                                    Background="#141E26"
                                    BorderBrush="#2B3B47"
                                    BorderThickness="1"
                                    CornerRadius="6">

                                <StackPanel IsEnabled="{Binding HasAdministrativeAuthorization}">
                                    <TextBlock Foreground="#E6EDF2"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Text="{x:Static properties:Resources.MirasActionRequiredRepositoryPathLabel}" />

                                    <TextBlock Margin="0,7,0,0"
                                               Foreground="#A6B4BF"
                                               FontSize="13"
                                               LineHeight="20"
                                               Text="{x:Static properties:Resources.MirasActionRequiredSelectRepositoryNotice}"
                                               TextWrapping="Wrap" />

                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox Grid.Column="0"
                                                 Height="44"
                                                 Padding="12,8"
                                                 VerticalContentAlignment="Center"
                                                 Foreground="#A6B4BF"
                                                 Background="#111A21"
                                                 BorderBrush="#2B3B47"
                                                 BorderThickness="1"
                                                 IsReadOnly="True"
                                                 Text="{Binding RepositoryPath, Mode=OneWay}" />

                                        <Button Grid.Column="2"
                                                MinWidth="120"
                                                Height="44"
                                                Padding="18,7"
                                                Command="{Binding SelectRepositoryCommand}"
                                                Content="{x:Static properties:Resources.MirasActionRequiredSelectRepository}"
                                                Cursor="Hand"
                                                FontSize="13"
                                                FontWeight="SemiBold" />
                                    </Grid>

                                    <!-- Current recovery status -->
                                    <Border Margin="0,18,0,0"
                                            Padding="14"
                                            Background="#111A21"
                                            BorderBrush="#2B3B47"
                                            BorderThickness="1"
                                            CornerRadius="5">

                                        <TextBlock Foreground="#A6B4BF"
                                                   FontSize="13"
                                                   LineHeight="20"
                                                   Text="{Binding StatusMessage}"
                                                   TextWrapping="Wrap" />
                                    </Border>

                                    <Grid Margin="0,20,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <ProgressBar Grid.Column="0"
                                                     Width="220"
                                                     Height="5"
                                                     Margin="0,0,20,0"
                                                     HorizontalAlignment="Left"
                                                     VerticalAlignment="Center"
                                                     IsIndeterminate="True">

                                            <ProgressBar.Style>
                                                <Style TargetType="ProgressBar">
                                                    <Setter Property="Visibility"
                                                            Value="Collapsed" />

                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBusy}"
                                                                     Value="True">

                                                            <Setter Property="Visibility"
                                                                    Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ProgressBar.Style>
                                        </ProgressBar>

                                        <Button Grid.Column="1"
                                                MinWidth="220"
                                                Height="44"
                                                Padding="18,7"
                                                Command="{Binding RecoverCommand}"
                                                Content="{x:Static properties:Resources.MirasActionRequiredRecover}"
                                                Foreground="#071317"
                                                Background="#57CCD9"
                                                BorderBrush="#57CCD9"
                                                BorderThickness="1"
                                                Cursor="Hand"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                IsDefault="True" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2"
                Background="#0D1318"
                BorderBrush="#2B3B47"
                BorderThickness="0,1,0,0">

            <TextBlock Margin="48,0"
                       VerticalAlignment="Center"
                       Foreground="#738490"
                       FontSize="11"
                       Text="{x:Static properties:Resources.MirasActionRequiredFooter}" />
        </Border>

        <!-- Busy protection -->
        <Border Grid.RowSpan="3"
                Background="#B010171D">

            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility"
                            Value="Collapsed" />

                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBusy}"
                                     Value="True">

                            <Setter Property="Visibility"
                                    Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <ProgressBar Width="240"
                             Height="5"
                             IsIndeterminate="True" />

                <TextBlock Margin="0,16,0,0"
                           MaxWidth="520"
                           HorizontalAlignment="Center"
                           Foreground="#E6EDF2"
                           FontSize="14"
                           Text="{Binding StatusMessage}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
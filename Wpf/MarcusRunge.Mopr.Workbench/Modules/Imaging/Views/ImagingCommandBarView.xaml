<UserControl x:Class="MarcusRunge.Mopr.Workbench.Modules.Imaging.Views.ImagingCommandBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:MarcusRunge.Toolbox.Localization.Wpf;assembly=MarcusRunge.Toolbox.Localization.Wpf"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:properties="clr-namespace:MarcusRunge.Mopr.Workbench.Modules.Imaging.Properties"
             xmlns:viewmodels="clr-namespace:MarcusRunge.Mopr.Workbench.Modules.Imaging.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:ImagingCommandBarViewModel}"
             mc:Ignorable="d"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <loc:EnumDescriptionValueConverter x:Key="EnumDescriptionValueConverter" />

        <Style x:Key="CommandBarDropDownButtonStyle"
               TargetType="Button">
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="Foreground"
                    Value="#DDE5EC" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Left" />
            <Setter Property="Padding"
                    Value="10,6" />
            <Setter Property="MinWidth"
                    Value="160" />
            <Setter Property="Cursor"
                    Value="Hand" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="#1B2730" />
                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="#22333D" />
                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter Property="Opacity"
                                        Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">

            <Button Margin="0,0,8,0"
                    Command="{Binding OpenCommand}"
                    Content="{Binding OpenButtonText}" />

            <Button Margin="0,0,8,0"
                    Command="{Binding ImportCommand}"
                    Content="{x:Static properties:Resources.CommandBar_Import}" />

            <Button Margin="0,0,8,0"
                    Command="{Binding CancelOpenCommand}"
                    Content="{x:Static properties:Resources.CommandBar_Cancel}"
                    Visibility="{Binding IsCancelVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <Button Margin="0,0,8,0"
                    Command="{Binding LayoutCommand}"
                    Content="{Binding CurrentLayout, Converter={StaticResource EnumDescriptionValueConverter}}" />

            <ToggleButton x:Name="WindowLevelPresetsToggleButton"
                          MinWidth="108"
                          Margin="0,0,8,0"
                          IsChecked="{Binding IsOpen, ElementName=WindowLevelPresetsPopup, Mode=TwoWay}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{x:Static properties:Resources.WindowLevel_Presets}" />
                    <TextBlock Margin="6,0,0,0"
                               Text="▾" />
                </StackPanel>
            </ToggleButton>

            <Popup x:Name="WindowLevelPresetsPopup"
                   AllowsTransparency="True"
                   Placement="Bottom"
                   PlacementTarget="{Binding ElementName=WindowLevelPresetsToggleButton}"
                   PopupAnimation="Fade"
                   StaysOpen="False">
                <Border MinWidth="180"
                        Padding="4"
                        Background="#10161C"
                        BorderBrush="#2A3944"
                        BorderThickness="1"
                        CornerRadius="6">
                    <StackPanel>
                        <Button Command="{Binding ApplyCtLungWindowCommand}"
                                Content="{x:Static properties:Resources.WindowLevel_CtLung}"
                                Style="{StaticResource CommandBarDropDownButtonStyle}" />

                        <Button Command="{Binding ApplyCtMediastinumWindowCommand}"
                                Content="{x:Static properties:Resources.WindowLevel_CtMediastinum}"
                                Style="{StaticResource CommandBarDropDownButtonStyle}" />

                        <Button Command="{Binding ApplyCtBoneWindowCommand}"
                                Content="{x:Static properties:Resources.WindowLevel_CtBone}"
                                Style="{StaticResource CommandBarDropDownButtonStyle}" />

                        <Button Command="{Binding ApplyCtBrainWindowCommand}"
                                Content="{x:Static properties:Resources.WindowLevel_CtBrain}"
                                Style="{StaticResource CommandBarDropDownButtonStyle}" />

                        <Border Height="1"
                                Margin="4"
                                Background="#2A3944" />

                        <Button Command="{Binding ResetWindowLevelToDefaultCommand}"
                                Content="{x:Static properties:Resources.WindowLevel_ResetToDefault}"
                                Style="{StaticResource CommandBarDropDownButtonStyle}" />
                    </StackPanel>
                </Border>
            </Popup>

            <ToggleButton Margin="0,0,8,0"
                          Command="{Binding ZoomCommand}"
                          Content="{x:Static properties:Resources.CommandBar_Zoom}"
                          IsChecked="{Binding IsZoomActive, Mode=OneWay}" />

            <ToggleButton Margin="0,0,8,0"
                          Command="{Binding PanCommand}"
                          Content="{x:Static properties:Resources.CommandBar_Pan}"
                          IsChecked="{Binding IsPanActive, Mode=OneWay}" />

            <ToggleButton Margin="0,0,8,0"
                          Command="{Binding CrosshairCommand}"
                          Content="{x:Static properties:Resources.CommandBar_Crosshair}"
                          IsChecked="{Binding IsCrosshairActive, Mode=OneWay}" />

            <ToggleButton Margin="0,0,8,0"
                          Command="{Binding MeasureCommand}"
                          Content="{x:Static properties:Resources.CommandBar_Measure}"
                          IsChecked="{Binding IsMeasureActive, Mode=OneWay}" />

            <Button Margin="0,0,8,0"
                    Command="{Binding ResetViewCommand}"
                    Content="{x:Static properties:Resources.CommandBar_ResetView}" />

            <Button Command="{Binding MoreCommand}"
                    Content="..." />
        </StackPanel>

        <Border Grid.Column="2"
                Padding="10,5"
                VerticalAlignment="Center"
                Background="#0B2A32"
                BorderBrush="#1C7F8C"
                BorderThickness="1"
                CornerRadius="10"
                Visibility="{Binding HasStatusText, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center"
                        Orientation="Horizontal">
                <Ellipse Width="7"
                         Height="7"
                         Margin="0,0,8,0"
                         Fill="#60E1EB" />

                <TextBlock VerticalAlignment="Center"
                           Foreground="#BEEEF3"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Text="{Binding StatusText}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
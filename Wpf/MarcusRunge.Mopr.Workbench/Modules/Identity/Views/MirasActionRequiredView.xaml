<UserControl x:Class="MarcusRunge.Mopr.Workbench.Modules.Identity.Views.MirasActionRequiredView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:properties="clr-namespace:MarcusRunge.Mopr.Workbench.Modules.Identity.Properties"
             xmlns:viewModels="clr-namespace:MarcusRunge.Mopr.Workbench.Modules.Identity.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewModels:MirasActionRequiredViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="1280"
             mc:Ignorable="d"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MarcusRunge.Mopr.Workbench.Modules.Identity;component/Themes/IdentityControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource IdentityBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="112" />
            <RowDefinition Height="*" />
            <RowDefinition Height="44" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource IdentityHeaderBackgroundBrush}"
                BorderBrush="{StaticResource IdentityCardBorderBrush}"
                BorderThickness="0,0,0,1">

            <Grid Margin="48,0">
                <StackPanel VerticalAlignment="Center">
                    <Border Padding="9,4"
                            HorizontalAlignment="Left"
                            Background="#3A2F18"
                            BorderBrush="#665329"
                            BorderThickness="1"
                            CornerRadius="4">

                        <TextBlock Foreground="{StaticResource IdentityWarningBrush}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Text="{x:Static properties:Resources.MirasActionRequiredBadge}" />
                    </Border>

                    <TextBlock Margin="0,10,0,0"
                               Style="{StaticResource IdentityPageTitleStyle}"
                               Text="{Binding Title}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Width="760"
              Margin="48"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">

            <Border Padding="36"
                    Background="{StaticResource IdentityCardBackgroundBrush}"
                    BorderBrush="#665329"
                    BorderThickness="1"
                    CornerRadius="8">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Width="56"
                            Height="56"
                            VerticalAlignment="Top"
                            Background="#3A2F18"
                            BorderBrush="#665329"
                            BorderThickness="1"
                            CornerRadius="28">

                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource IdentityWarningBrush}"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Text="!" />
                    </Border>

                    <StackPanel Grid.Column="2">
                        <TextBlock Foreground="{StaticResource IdentityTextBrush}"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Text="{Binding Title}"
                                   TextWrapping="Wrap" />

                        <TextBlock Margin="0,14,0,0"
                                   Foreground="{StaticResource IdentitySecondaryTextBrush}"
                                   FontSize="14"
                                   LineHeight="22"
                                   Text="{Binding Description}"
                                   TextWrapping="Wrap" />

                        <Border Margin="0,24,0,0"
                                Padding="16"
                                Background="#182129"
                                BorderBrush="{StaticResource IdentityCardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">

                            <TextBlock Foreground="{StaticResource IdentitySecondaryTextBrush}"
                                       FontSize="13"
                                       LineHeight="20"
                                       Text="{x:Static properties:Resources.MirasActionRequiredSafetyNotice}"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Background="#0D1318"
                BorderBrush="{StaticResource IdentityCardBorderBrush}"
                BorderThickness="0,1,0,0">

            <TextBlock Margin="48,0"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource IdentityMutedTextBrush}"
                       FontSize="11"
                       Text="{x:Static properties:Resources.MirasActionRequiredFooter}" />
        </Border>
    </Grid>
</UserControl>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <!-- Shared MOPR palette. Keep these values synchronized with the application theme. -->
    <SolidColorBrush x:Key="SetupBackgroundBrush" Color="#0D151B" />
    <SolidColorBrush x:Key="SetupHeaderBackgroundBrush" Color="#121B22" />
    <SolidColorBrush x:Key="SetupCardBackgroundBrush" Color="#111B22" />
    <SolidColorBrush x:Key="SetupCardSecondaryBackgroundBrush" Color="#17242D" />
    <SolidColorBrush x:Key="SetupCardBorderBrush" Color="#263944" />
    <SolidColorBrush x:Key="SetupTextBrush" Color="#E6EDF2" />
    <SolidColorBrush x:Key="SetupSecondaryTextBrush" Color="#9AACB8" />
    <SolidColorBrush x:Key="SetupMutedTextBrush" Color="#71838F" />
    <SolidColorBrush x:Key="SetupAccentBrush" Color="#62D4DF" />
    <SolidColorBrush x:Key="SetupAccentBackgroundBrush" Color="#173A43" />
    <SolidColorBrush x:Key="SetupControlHoverBackgroundBrush" Color="#29434B" />
    <SolidColorBrush x:Key="SetupControlPressedBackgroundBrush" Color="#20383F" />

    <!-- Setup-specific state colors. -->
    <SolidColorBrush x:Key="SetupAccentHoverBrush" Color="#72DAE5" />
    <SolidColorBrush x:Key="SetupAccentPressedBrush" Color="#3EABB8" />
    <SolidColorBrush x:Key="SetupSuccessBrush" Color="#61D6A2" />
    <SolidColorBrush x:Key="SetupWarningBrush" Color="#F2C14E" />
    <SolidColorBrush x:Key="SetupErrorBrush" Color="#F0787F" />

    <Style x:Key="SetupSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource SetupTextBrush}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SetupDescriptionStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource SetupSecondaryTextBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="21" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SetupLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource SetupTextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SetupTextBoxStyle" TargetType="TextBox">
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Foreground" Value="{StaticResource SetupTextBrush}" />
        <Setter Property="Background" Value="{StaticResource SetupCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SetupCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{StaticResource SetupAccentBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource SetupAccentBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource SetupAccentBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.55" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SetupPrimaryButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="40" />
        <Setter Property="MinWidth" Value="150" />
        <Setter Property="Padding" Value="18,7" />
        <Setter Property="Foreground" Value="{StaticResource SetupBackgroundBrush}" />
        <Setter Property="Background" Value="{StaticResource SetupAccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SetupAccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource SetupAccentHoverBrush}" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource SetupAccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource SetupAccentPressedBrush}" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource SetupAccentPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource SetupTextBrush}" />
                            <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.38" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SetupSecondaryButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="40" />
        <Setter Property="MinWidth" Value="130" />
        <Setter Property="Padding" Value="18,7" />
        <Setter Property="Foreground" Value="{StaticResource SetupTextBrush}" />
        <Setter Property="Background" Value="{StaticResource SetupCardSecondaryBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SetupCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource SetupControlHoverBackgroundBrush}" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource SetupAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource SetupControlPressedBackgroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource SetupAccentBrush}" />
                            <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.38" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SetupStepNumberStyle" TargetType="Border">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Background" Value="{StaticResource SetupCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SetupCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="17" />
    </Style>

    <Style x:Key="AdministrationCardStyle" TargetType="Border">
        <Setter Property="Margin" Value="0,0,16,16" />
        <Setter Property="Padding" Value="22" />
        <Setter Property="MinHeight" Value="132" />
        <Setter Property="Background" Value="{StaticResource SetupCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SetupCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style x:Key="AdministrationCardTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource SetupTextBrush}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
</ResourceDictionary>

<Window x:Class="MarcusRunge.Mopr.Workbench.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:core="clr-namespace:MarcusRunge.Mopr.Workbench.Core;assembly=MarcusRunge.Mopr.Workbench.Core"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:viewModels="clr-namespace:MarcusRunge.Mopr.Workbench.ViewModels"
        d:DataContext="{d:DesignInstance Type=viewModels:MainWindowViewModel}"
        Width="1280"
        Height="800"
        MinWidth="1024"
        MinHeight="680"
        Background="#111B22"
        mc:Ignorable="d"
        prism:ViewModelLocator.AutoWireViewModel="True"
        Title="{Binding Title}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <SolidColorBrush x:Key="WorkbenchBackgroundBrush" Color="#0D151B" />
            <SolidColorBrush x:Key="WorkbenchHeaderBackgroundBrush" Color="#121B22" />
            <SolidColorBrush x:Key="WorkbenchCommandBarBackgroundBrush" Color="#172129" />
            <SolidColorBrush x:Key="WorkbenchPanelBackgroundBrush" Color="#111B22" />
            <SolidColorBrush x:Key="WorkbenchSecondaryPanelBackgroundBrush" Color="#17242D" />
            <SolidColorBrush x:Key="WorkbenchFooterBackgroundBrush" Color="#0B1116" />
            <SolidColorBrush x:Key="WorkbenchViewerBackgroundBrush" Color="#030607" />
            <SolidColorBrush x:Key="WorkbenchBorderBrush" Color="#263944" />
            <SolidColorBrush x:Key="WorkbenchStrongBorderBrush" Color="#31515D" />
            <SolidColorBrush x:Key="WorkbenchSplitterBrush" Color="#25343D" />
            <SolidColorBrush x:Key="WorkbenchTextBrush" Color="#E6EDF2" />
            <SolidColorBrush x:Key="WorkbenchSecondaryTextBrush" Color="#9AACB8" />
            <SolidColorBrush x:Key="WorkbenchMutedTextBrush" Color="#71838F" />
            <SolidColorBrush x:Key="WorkbenchControlBackgroundBrush" Color="#222D35" />
            <SolidColorBrush x:Key="WorkbenchControlHoverBackgroundBrush" Color="#29434B" />
            <SolidColorBrush x:Key="WorkbenchControlPressedBackgroundBrush" Color="#20383F" />
            <SolidColorBrush x:Key="WorkbenchAccentBrush" Color="#62D4DF" />
            <SolidColorBrush x:Key="WorkbenchAccentBackgroundBrush" Color="#173A43" />
            <SolidColorBrush x:Key="WorkbenchAccentBorderBrush" Color="#2A5963" />
            <SolidColorBrush x:Key="WorkbenchSuccessBrush" Color="#61D6A2" />

            <!-- Concrete compatibility brushes. No StaticResourceExtension aliases. -->
            <SolidColorBrush x:Key="SetupBackgroundBrush" Color="#0D151B" />
            <SolidColorBrush x:Key="SetupHeaderBackgroundBrush" Color="#121B22" />
            <SolidColorBrush x:Key="SetupCardBackgroundBrush" Color="#111B22" />
            <SolidColorBrush x:Key="SetupCardSecondaryBackgroundBrush" Color="#17242D" />
            <SolidColorBrush x:Key="SetupCardBorderBrush" Color="#263944" />
            <SolidColorBrush x:Key="SetupTextBrush" Color="#E6EDF2" />
            <SolidColorBrush x:Key="SetupSecondaryTextBrush" Color="#9AACB8" />
            <SolidColorBrush x:Key="SetupMutedTextBrush" Color="#71838F" />
            <SolidColorBrush x:Key="SetupAccentBrush" Color="#62D4DF" />
            <SolidColorBrush x:Key="SetupAccentBackgroundBrush" Color="#173A43" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="#111B22">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ContentControl Grid.Row="0"
                        prism:RegionManager.RegionName="{x:Static core:RegionNames.ContentRegion}" />

        <Border Grid.Row="1"
                MinHeight="44"
                Padding="18,6"
                Background="#0B1116"
                BorderBrush="#263944"
                BorderThickness="0,1,0,0"
                Visibility="{Binding HasCurrentUser, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Border Width="9"
                            Height="9"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Background="#61D6A2"
                            CornerRadius="5" />

                    <StackPanel>
                        <TextBlock HorizontalAlignment="Right"
                                   Foreground="#E6EDF2"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Text="{Binding CurrentUserDisplayName}" />

                        <TextBlock Margin="0,2,0,0"
                                   HorizontalAlignment="Right"
                                   Foreground="#71838F"
                                   FontSize="11"
                                   Text="{Binding CurrentUserDetails}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

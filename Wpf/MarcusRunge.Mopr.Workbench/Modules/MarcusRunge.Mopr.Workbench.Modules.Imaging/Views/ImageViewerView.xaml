<UserControl x:Class="MarcusRunge.Mopr.Workbench.Modules.Imaging.Views.ImageViewerView"
             xmlns:behaviors="clr-namespace:MarcusRunge.Mopr.Workbench.Modules.Imaging.Behaviors"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:viewmodels="clr-namespace:MarcusRunge.Mopr.Workbench.Modules.Imaging.ViewModels"
             xmlns:viewports="clr-namespace:MarcusRunge.Mopr.Workbench.Modules.Imaging.Views.Viewports"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             d:DataContext="{d:DesignInstance Type=viewmodels:ImageViewerViewModel}"
             Focusable="True"
             mc:Ignorable="d"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <Grid Background="#030506"
          ClipToBounds="True"
          behaviors:FocusOnMouseDownBehavior.IsEnabled="True">
        <i:Interaction.Triggers>
            <i:EventTrigger EventName="PreviewMouseWheel">
                <prism:InvokeCommandAction Command="{Binding MouseWheelCommand}" />
            </i:EventTrigger>

            <i:EventTrigger EventName="PreviewKeyDown">
                <prism:InvokeCommandAction Command="{Binding KeyDownCommand}" />
            </i:EventTrigger>
        </i:Interaction.Triggers>

        <Border Background="#05080A"
                BorderBrush="#1F2933"
                BorderThickness="1"
                Margin="16">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="42" />
                </Grid.RowDefinitions>

                <!-- Viewport-Fläche ohne störende globale Overlays -->
                <viewports:ViewportLayoutHost Grid.Row="0" />

                <!-- Saubere Statusleiste unten -->
                <Border Grid.Row="1"
                        Background="#10161C"
                        BorderBrush="#1F2933"
                        BorderThickness="0,1,0,0"
                        Padding="12,0">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Aktiver Viewport -->
                        <TextBlock Grid.Column="0"
                                   Text="{Binding ActiveViewportDisplayText}"
                                   Foreground="#8FA0AD"
                                   VerticalAlignment="Center"
                                   FontSize="12" />

                        <!-- Werkzeug -->
                        <TextBlock Grid.Column="2"
                                   Text="{Binding ActiveToolDisplayText}"
                                   Foreground="#7FDDE8"
                                   VerticalAlignment="Center"
                                   FontSize="12" />

                        <!-- Layout -->
                        <TextBlock Grid.Column="4"
                                   Text="{Binding LayoutDisplayText}"
                                   Foreground="#8FA0AD"
                                   VerticalAlignment="Center"
                                   FontSize="12" />

                        <!-- Zoom -->
                        <StackPanel Grid.Column="6"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <TextBlock Text="Zoom"
                                       Foreground="#8FA0AD"
                                       Margin="0,0,6,0" />

                            <TextBlock Text="{Binding ZoomDisplayText}"
                                       Foreground="#DDE5EC"
                                       FontWeight="SemiBold" />
                        </StackPanel>

                        <!-- Aktuelle Datei -->
                        <Grid Grid.Column="8"
                              Margin="0,0,16,0"
                              VerticalAlignment="Center"
                              MinWidth="0"
                              ClipToBounds="True">

                            <TextBlock Text="{Binding CurrentFileDisplayText}"
                                       Foreground="#6F7B86"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding CurrentFileToolTipText}" />
                        </Grid>

                        <!-- Slice Slider -->
                        <Slider Grid.Column="9"
                                VerticalAlignment="Center"
                                Minimum="1"
                                Maximum="{Binding SliceCount}"
                                Value="{Binding CurrentSlice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                IsMoveToPointEnabled="True" />

                        <!-- Slice Text -->
                        <StackPanel Grid.Column="11"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <TextBlock Text="{Binding SliceDisplayText}"
                                       Foreground="#DDE5EC"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       ToolTip="{Binding CurrentFileToolTipText}" />

                            <Border Width="18"
                                    Height="18"
                                    Margin="6,0,0,0"
                                    CornerRadius="9"
                                    Background="#16242B"
                                    BorderBrush="#3A4B55"
                                    BorderThickness="1"
                                    VerticalAlignment="Center"
                                    ToolTip="{Binding CurrentFileToolTipText}">

                                <TextBlock Text="i"
                                           Foreground="#8FA0AD"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
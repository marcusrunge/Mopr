<UserControl x:Class="MarcusRunge.Mopr.Workbench.Modules.Identity.Views.IdentityUnavailableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:properties="clr-namespace:MarcusRunge.Mopr.Workbench.Modules.Identity.Properties"
             d:DesignHeight="800"
             d:DesignWidth="1280"
             mc:Ignorable="d"
             prism:ViewModelLocator.AutoWireViewModel="False">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MarcusRunge.Mopr.Workbench.Modules.Identity;component/Themes/IdentityControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource IdentityBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="112" />
            <RowDefinition Height="*" />
            <RowDefinition Height="44" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource IdentityHeaderBackgroundBrush}"
                BorderBrush="{StaticResource IdentityCardBorderBrush}"
                BorderThickness="0,0,0,1">

            <Grid Margin="48,0">
                <StackPanel VerticalAlignment="Center">
                    <Border Padding="9,4"
                            HorizontalAlignment="Left"
                            Background="#3A2024"
                            BorderBrush="#66363B"
                            BorderThickness="1"
                            CornerRadius="4">

                        <TextBlock Foreground="{StaticResource IdentityErrorBrush}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Text="{x:Static properties:Resources.IdentityStatusCaption}" />
                    </Border>

                    <TextBlock Margin="0,10,0,0"
                               Style="{StaticResource IdentityPageTitleStyle}"
                               Text="{x:Static properties:Resources.IdentityUnavailableTitle}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Width="820"
              Margin="48"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">

            <Border Padding="36"
                    Background="{StaticResource IdentityCardBackgroundBrush}"
                    BorderBrush="{StaticResource IdentityCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">

                <StackPanel>
                    <Ellipse Width="14"
                             Height="14"
                             HorizontalAlignment="Left"
                             Fill="{StaticResource IdentityErrorBrush}" />

                    <TextBlock Margin="0,22,0,0"
                               Style="{StaticResource IdentitySectionTitleStyle}"
                               Text="{x:Static properties:Resources.IdentityUnavailableTitle}" />

                    <TextBlock Margin="0,14,0,0"
                               Style="{StaticResource IdentityDescriptionStyle}"
                               Text="{x:Static properties:Resources.IdentityUnavailableDescription}" />

                    <Border Margin="0,28,0,0"
                            Style="{StaticResource IdentityStatusCardStyle}">

                        <TextBlock Foreground="{StaticResource IdentitySecondaryTextBrush}"
                                   FontSize="14"
                                   LineHeight="21"
                                   Text="{x:Static properties:Resources.IdentityUnavailableAction}"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Background="#0D1318"
                BorderBrush="{StaticResource IdentityCardBorderBrush}"
                BorderThickness="0,1,0,0">

            <TextBlock Margin="48,0"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource IdentityMutedTextBrush}"
                       FontSize="11"
                       Text="{x:Static properties:Resources.IdentityUnavailableAction}" />
        </Border>
    </Grid>
</UserControl>
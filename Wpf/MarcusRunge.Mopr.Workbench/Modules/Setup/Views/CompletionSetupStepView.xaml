<UserControl x:Class="MarcusRunge.Mopr.Workbench.Modules.Setup.Views.Steps.CompletionSetupStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:properties="clr-namespace:MarcusRunge.Mopr.Workbench.Modules.Setup.Properties"
             d:DesignHeight="620"
             d:DesignWidth="788"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MarcusRunge.Mopr.Workbench.Modules.Setup;component/Themes/SetupControls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Padding="32"
            VerticalAlignment="Top"
            Background="{StaticResource SetupCardBackgroundBrush}"
            BorderBrush="{StaticResource SetupCardBorderBrush}"
            BorderThickness="1"
            CornerRadius="9">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="1" />
                <RowDefinition Height="24" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Width="48"
                        Height="48"
                        Background="{StaticResource SetupAccentBackgroundBrush}"
                        BorderBrush="#2A5963"
                        BorderThickness="1"
                        CornerRadius="7">

                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource SetupAccentBrush}"
                               FontSize="15"
                               FontWeight="Bold"
                               Text="ARM" />
                </Border>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource SetupSectionTitleStyle}"
                               Text="{x:Static properties:Resources.Setup_CompletionTitle}" />

                    <TextBlock Margin="0,5,0,0"
                               Style="{StaticResource SetupDescriptionStyle}"
                               Text="{x:Static properties:Resources.Setup_CompletionDescription}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" Background="{StaticResource SetupCardBorderBrush}" />

            <Border Grid.Row="4"
                    Padding="18"
                    Background="#14232B"
                    BorderBrush="{StaticResource SetupCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Width="24"
                            Height="24"
                            Background="#173740"
                            BorderBrush="#2A5963"
                            BorderThickness="1"
                            CornerRadius="12">

                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource SetupSuccessBrush}"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Text="✓" />
                    </Border>

                    <StackPanel Grid.Column="2">
                        <TextBlock Foreground="{StaticResource SetupTextBrush}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Text="{x:Static properties:Resources.Setup_CompletionReadyTitle}" />

                        <TextBlock Margin="0,7,0,0"
                                   Foreground="{StaticResource SetupSecondaryTextBrush}"
                                   FontSize="13"
                                   LineHeight="20"
                                   Text="{x:Static properties:Resources.Setup_CompletionReadyDescription}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="6"
                    Padding="16"
                    Background="#27231A"
                    BorderBrush="#5B4C26"
                    BorderThickness="1"
                    CornerRadius="6">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Width="24"
                            Height="24"
                            Background="#443819"
                            CornerRadius="12">

                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource SetupWarningBrush}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Text="!" />
                    </Border>

                    <TextBlock Grid.Column="2"
                               VerticalAlignment="Center"
                               Foreground="#D9C98E"
                               FontSize="13"
                               LineHeight="20"
                               Text="{x:Static properties:Resources.Setup_CompletionNoChangesNotice}"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>

            <Border Grid.Row="8"
                    Padding="16"
                    Background="#111C22"
                    BorderBrush="{StaticResource SetupCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">

                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CompletionStatusText}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ProgressBar Width="92"
                                 Height="4"
                                 VerticalAlignment="Center"
                                 IsIndeterminate="True"
                                 Visibility="{Binding IsCompletingSetup, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <TextBlock Grid.Column="2"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource SetupSecondaryTextBrush}"
                               FontSize="13"
                               LineHeight="20"
                               Text="{Binding CompletionStatusText}"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>

            <Grid Grid.Row="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{StaticResource SetupSecondaryButtonStyle}"
                        Command="{Binding BackCommand}"
                        Content="{x:Static properties:Resources.Setup_Back}" />

                <Button Grid.Column="2"
                        MinWidth="130"
                        Style="{StaticResource SetupSecondaryButtonStyle}"
                        Command="{Binding CancelSetupCompletionCommand}"
                        Content="{x:Static properties:Resources.Setup_CancelSetupCompletion}"
                        Visibility="{Binding IsCompletingSetup, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <Button Grid.Column="2"
                        MinWidth="190"
                        Command="{Binding CompleteSetupCommand}"
                        Content="{x:Static properties:Resources.Setup_CompleteSetup}">

                    <Button.Style>
                        <Style BasedOn="{StaticResource SetupPrimaryButtonStyle}" TargetType="Button">
                            <Setter Property="Visibility" Value="Visible" />

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompletingSetup}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>
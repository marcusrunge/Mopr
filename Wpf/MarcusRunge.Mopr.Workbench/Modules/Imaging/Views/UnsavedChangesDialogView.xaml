<UserControl x:Class="MarcusRunge.Mopr.Workbench.Modules.Imaging.Views.UnsavedChangesDialogView"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewmodels="clr-namespace:MarcusRunge.Mopr.Workbench.Modules.Imaging.ViewModels"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:properties="clr-namespace:MarcusRunge.Mopr.Workbench.Modules.Imaging.Properties"
             d:DataContext="{d:DesignInstance Type=viewmodels:UnsavedChangesDialogViewModel}"
             Width="720"
             mc:Ignorable="d"
             Background="#10161C"
             Foreground="#F3F7FA"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="Width" Value="720" />
            <Setter Property="MinWidth" Value="620" />
            <Setter Property="SizeToContent" Value="Height" />
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterOwner" />
            <Setter Property="ResizeMode" Value="NoResize" />
            <Setter Property="ShowInTaskbar" Value="False" />
            <Setter Property="Background" Value="#10161C" />
        </Style>
    </prism:Dialog.WindowStyle>

    <UserControl.Resources>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="110" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="Background" Value="#2E78B7" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#4B96D1" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="100" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="Background" Value="#26323C" />
            <Setter Property="Foreground" Value="#F3F7FA" />
            <Setter Property="BorderBrush" Value="#51616D" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="DestructiveButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="Background" Value="#3B292B" />
            <Setter Property="BorderBrush" Value="#875157" />
        </Style>
    </UserControl.Resources>

    <Grid Background="#10161C">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="28,24,28,24">
            <TextBlock FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#F3F7FA"
                       Text="{x:Static properties:Resources.UnsavedChangesDialog_Message}"
                       TextWrapping="Wrap" />

            <TextBlock Margin="0,12,0,0"
                       Foreground="#AFC0CB"
                       Text="{x:Static properties:Resources.UnsavedChangesDialog_Warning}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1"
                MinHeight="68"
                Padding="20,14"
                Background="#182129"
                BorderBrush="#2F3E49"
                BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Margin="0,0,10,0"
                        Command="{Binding SaveCommand}"
                        Content="{x:Static properties:Resources.UnsavedChangesDialog_Save}"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButtonStyle}" />

                <Button Margin="0,0,10,0"
                        Command="{Binding DiscardCommand}"
                        Content="{x:Static properties:Resources.UnsavedChangesDialog_Discard}"
                        Style="{StaticResource DestructiveButtonStyle}" />

                <Button Command="{Binding CancelCommand}"
                        Content="{x:Static properties:Resources.UnsavedChangesDialog_Cancel}"
                        IsCancel="True"
                        Style="{StaticResource SecondaryButtonStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

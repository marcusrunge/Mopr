<UserControl x:Class="MarcusRunge.Mopr.Workbench.Modules.Setup.Views.SystemCheckView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:properties="clr-namespace:MarcusRunge.Mopr.Workbench.Modules.Setup.Properties"
             xmlns:viewModels="clr-namespace:MarcusRunge.Mopr.Workbench.Modules.Setup.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewModels:SystemCheckViewModel}"
             mc:Ignorable="d"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MarcusRunge.Mopr.Workbench.Modules.Setup;component/Themes/SetupControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="SystemCheckCardStyle" TargetType="Border">
                <Setter Property="Margin" Value="0,0,0,12" />
                <Setter Property="Padding" Value="18" />
                <Setter Property="Background" Value="{StaticResource WorkbenchSecondaryPanelBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource WorkbenchBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource SetupSectionTitleStyle}" Text="{x:Static properties:Resources.Administration_SystemCheck}" />
            <Button Grid.Column="1" Margin="0,0,10,0" Style="{StaticResource SetupSecondaryButtonStyle}" Command="{Binding CancelCommand}" Content="{x:Static properties:Resources.SystemCheck_Cancel}" />
            <Button Grid.Column="2" Style="{StaticResource SetupPrimaryButtonStyle}" Command="{Binding RunCommand}" Content="{x:Static properties:Resources.SystemCheck_Start}" />
        </Grid>

        <TextBlock Grid.Row="1" Margin="0,9,0,18" Style="{StaticResource SetupDescriptionStyle}" Text="{x:Static properties:Resources.Administration_SystemCheckDescription}" />

        <Border Grid.Row="2" Margin="0,0,0,16" Padding="15" Background="{StaticResource WorkbenchAccentBackgroundBrush}" BorderBrush="{StaticResource WorkbenchAccentBorderBrush}" BorderThickness="1" CornerRadius="6">
            <StackPanel>
                <TextBlock Foreground="{StaticResource WorkbenchTextBrush}" FontWeight="SemiBold" Text="{Binding OverallStatusText}" TextWrapping="Wrap" />
                <TextBlock Margin="0,5,0,0" Foreground="{StaticResource WorkbenchSecondaryTextBrush}" Text="{Binding StatusText}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Sections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource SystemCheckCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Foreground="{StaticResource WorkbenchTextBrush}" FontSize="16" FontWeight="SemiBold" Text="{Binding Title}" />
                                    <TextBlock Grid.Column="1" Margin="18,0,0,0" Foreground="{StaticResource WorkbenchAccentBrush}" FontWeight="SemiBold" Text="{Binding StatusText}" />
                                </Grid>
                                <TextBlock Grid.Row="1" Margin="0,8,0,0" Foreground="{StaticResource WorkbenchSecondaryTextBrush}" Text="{Binding Summary}" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="2" Margin="0,8,0,0" Foreground="{StaticResource WorkbenchMutedTextBrush}" Text="{Binding ScannedItems, StringFormat={x:Static properties:Resources.SystemCheck_ScannedItemsFormat}}">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding HasScannedItems}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                                <ItemsControl Grid.Row="3" Margin="0,10,0,0" ItemsSource="{Binding Details}">
                                    <ItemsControl.ItemTemplate><DataTemplate><TextBlock Margin="0,0,0,4" Foreground="{StaticResource WorkbenchSecondaryTextBrush}" Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="4" Margin="0,14,0,0" Foreground="{StaticResource WorkbenchMutedTextBrush}" Text="{Binding Duration, StringFormat={x:Static properties:Resources.SystemCheck_DurationFormat}}">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding HasResult}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
